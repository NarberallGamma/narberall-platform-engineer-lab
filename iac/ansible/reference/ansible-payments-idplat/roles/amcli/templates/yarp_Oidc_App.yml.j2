    RequestObjectEncryptionAlg:
    RequestObjectEncryptionEncValues:
    IdentityTokenSignedResponseAlg: RS256
    IdentityTokenEncryptionAlg:
    IdentityTokenEncryptionEncValues:
    RequirePkce: false
    UserInfoSignedResponseAlg: none
    ProtectAgainstReplayAttack: true
  Secrets:
