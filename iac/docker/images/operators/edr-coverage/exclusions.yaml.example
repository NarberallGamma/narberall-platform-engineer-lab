# Hosts excluded from the EDR coverage calculation (appliances, network gear, etc.)
# Excluded hosts stay in edr_coverage_report.csv with excluded=True
# but are not counted in metrics.
#
# Rules apply in order: global → company.
# A host is excluded if at least one rule from any section matches.

# Applied to all companies
global:
  # Glob patterns on hostname (case-insensitive). * — any substring, ? — one character.
  patterns:
    - "fw-*"          # firewalls
    - "sw-*"          # switches
    - "palo-*"        # Palo Alto
    - "*.oob"         # out-of-band management
  # Exact hostnames (case-insensitive)
  hostnames: []
  # IP addresses (exact match against the sourceip field)
  ips: []
  # Active Directory OUs: a host is excluded if its DN contains any of these suffixes.
  # Given as a DN fragment starting with OU= (case-insensitive).
  ous: []

# Per-company extras (added to global, not replacing it)
companies:
  my-company:
    patterns:
      - "printer-*"
      - "ups-*"
      - "kvm-*"
    hostnames:
      - "mgmt-idrac-01"
      - "mgmt-idrac-02"
    ips:
      - "192.168.1.1"
    ous:
      - "OU=Network Devices,DC=corp,DC=example,DC=com"
      - "OU=Printers,DC=corp,DC=example,DC=com"

  other-company:
    patterns:
      - "checkpoint-*"
    hostnames: []
    ips: []
    ous: []
