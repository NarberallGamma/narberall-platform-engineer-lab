{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Timeseries"
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Cloud.ru Advanced: service status mini time-series (4 per row) and emergency/planned work table. Status: Available, Partial, Down. Data from cloud-ru-status-exporter. Full status: https://cloud.ru/status  -  Events: https://cloud.ru/status/events",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 3,
      "panels": [],
      "targets": [{ "datasource": "${DS_PROMETHEUS}", "refId": "A" }],
      "title": "Emergency & Planned Work",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Current emergency and planned work from Cloud.ru (only events currently reported by the exporter). Full description and details: https://cloud.ru/status/events",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "displayMode": "auto", "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 1 },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Start" }]
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "cloud_ru_emergency_event_info",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Emergency & Planned Work Events",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "id": true,
              "__name__": true,
              "cluster": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "service": true,
              "exported_service": true
            },
            "indexByName": {
              "Time": 99,
              "Value": 99,
              "description": 7,
              "end_at": 6,
              "event_type": 3,
              "id": 99,
              "inaccessibility": 5,
              "start_at": 4,
              "status": 2,
              "title": 1
            },
            "renameByName": {
              "description": "Description",
              "end_at": "End",
              "event_type": "Type",
              "inaccessibility": "Inaccessibility",
              "start_at": "Start",
              "status": "Status",
              "title": "Title"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 1,
      "panels": [],
      "targets": [{ "datasource": "${DS_PROMETHEUS}", "refId": "A" }],
      "title": "Cloud Services Global - Status",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "One mini graph per service. Y-axis: Available (top), Partial availability (middle), Down (bottom). Area fill by status. Source: cloud-ru-status-exporter. Full status page: https://cloud.ru/status",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Status",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 100,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "area" }
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "Partial availability", "color": "yellow", "index": 0 } } },
            { "type": "value", "options": { "2": { "text": "Available", "color": "green", "index": 0 } } },
            { "type": "special", "options": { "match": "null", "result": { "text": "N/A", "index": 0 } } }
          ],
          "max": 2,
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 14 },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "pluginVersion": "12.3.0",
      "repeat": "service",
      "repeatDirection": "h",
      "maxPerRow": 4,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "max by (title) ((cloud_ru_service_availability_status{platform=\"advanced\",title=\"$service\"} == 1) * 2 or (cloud_ru_service_availability_status{platform=\"advanced\",title=\"$service\"} == 0) * 1 or (cloud_ru_service_availability_status{platform=\"advanced\",title=\"$service\"} == 2) * 0)",
          "interval": "60s",
          "legendFormat": "{{title}}",
          "refId": "A"
        }
      ],
      "title": "$service",
      "type": "timeseries"
    }
  ],
  "refresh": "20s",
  "schemaVersion": 39,
  "tags": ["SberCloud", "Cloud.ru"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allValue": "",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(cloud_ru_service_availability_status{platform=\"advanced\"}, title)",
        "hide": 2,
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": "label_values(cloud_ru_service_availability_status{platform=\"advanced\"}, title)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "20s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "timezone": "",
  "title": "Cloud.ru / Global",
  "uid": "cloud-ru-global",
  "version": 1,
  "weekStart": ""
}
