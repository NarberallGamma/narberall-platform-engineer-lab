variables:
    # CI_JOB_TOKEN is enough; extra registry tokens are not required.
    _SCRIPTS_REPO: "https://gitlab-ci-token:${CI_JOB_TOKEN}@${CI_SERVER_HOST}/security/security-gates.git"
    _SCRIPTS_REF: "main"
    _SCRIPTS_DIR: "/tmp/security-scripts"

# YAML anchor: clone the scripts repo inside the job.
.fetch_scripts: &fetch_scripts
    - |
        if [ ! -d "${_SCRIPTS_DIR}/.git" ]; then
          echo "==> Fetching security-scripts @ ${_SCRIPTS_REF}"
          rm -rf "${_SCRIPTS_DIR}"
          if ! git clone --depth 1 --branch "${_SCRIPTS_REF}" "${_SCRIPTS_REPO}" "${_SCRIPTS_DIR}"; then
            echo "ERROR: git clone failed" >&2
            exit 1
          fi
        fi
        echo "=== DEBUG: ${_SCRIPTS_DIR} contents ==="
        ls -la "${_SCRIPTS_DIR}"
        echo "=== DEBUG: ${_SCRIPTS_DIR}/scripts contents ==="
        ls -la "${_SCRIPTS_DIR}/scripts" 2>&1 || echo "scripts/ NOT FOUND"

# Template 1  -  create a DefectDojo Engagement (stage .pre)
.defectdojo_create_engagement:
    stage: .pre
    image: alpine:3.19
    variables:
        DEFECTDOJO_ENGAGEMENT_PERIOD: "0"
        DEFECTDOJO_ENGAGEMENT_STATUS: "Not Started"
        DEFECTDOJO_ENGAGEMENT_BUILD_SERVER: "null"
        DEFECTDOJO_ENGAGEMENT_SOURCE_CODE_MANAGEMENT_SERVER: "null"
        DEFECTDOJO_ENGAGEMENT_ORCHESTRATION_ENGINE: "null"
        DEFECTDOJO_ENGAGEMENT_DEDUPLICATION_ON_ENGAGEMENT: "false"
        DEFECTDOJO_ENGAGEMENT_THREAT_MODEL: "false"
        DEFECTDOJO_ENGAGEMENT_API_TEST: "true"
        DEFECTDOJO_ENGAGEMENT_PEN_TEST: "false"
        DEFECTDOJO_ENGAGEMENT_CHECK_LIST: "true"
    before_script:
        - apk add --no-cache curl jq coreutils git dos2unix bash
        - *fetch_scripts
    script:
        - apk add --no-cache bash curl jq coreutils git dos2unix
        - sed -i 's/\r$//' "${_SCRIPTS_DIR}/scripts/defectdojo_create_engagement.sh"
        - bash "${_SCRIPTS_DIR}/scripts/defectdojo_create_engagement.sh"
    artifacts:
        reports:
            dotenv: defectdojo.env

# Template 2  -  import scan results into DefectDojo (after_script)
.import_results_base:
    variables:
        DEFECTDOJO_SCAN_MINIMUM_SEVERITY: "Low"
        DEFECTDOJO_SCAN_ACTIVE: "true"
        DEFECTDOJO_SCAN_VERIFIED: "false"
        DEFECTDOJO_SCAN_CLOSE_OLD_FINDINGS: "true"
        DEFECTDOJO_SCAN_CLOSE_OLD_FINDINGS_PRODUCT_SCOPE: "true"
        DEFECTDOJO_SCAN_PUSH_TO_JIRA: "false"
        DEFECTDOJO_SCAN_ENVIRONMENT: "Default"
    before_script:
        - apk add --no-cache curl jq bash git 2>/dev/null || apt-get install -y --no-install-recommends curl jq git 2>/dev/null || true
        - *fetch_scripts
    after_script:
        - |
            if [ ! -d "${_SCRIPTS_DIR}/.git" ]; then
              git clone --depth 1 --branch "${_SCRIPTS_REF}" "${_SCRIPTS_REPO}" "${_SCRIPTS_DIR}"
            fi
        - bash "${_SCRIPTS_DIR}/scripts/defectdojo_import_scan.sh"

# Template 3  -  Dependency-Track → DefectDojo
.dependency_track:
    image: alpine:3.19
    variables:
        DT_URL: "http://10.10.0.20:8081"
        DT_ANALYSIS_WAIT_SECONDS: "20"
        PROJECT_VERSION: "1.0.0"
        BOM_FILE: "bom.json"
        DEFECTDOJO_SCAN_FILE: "dependency-report.json"
        DEFECTDOJO_SCAN_TYPE: "Dependency Track Finding Packaging Format (FPF) Export"
        DEFECTDOJO_SCAN_MINIMUM_SEVERITY: "Low"
    before_script:
        - apk add --no-cache curl jq git bash
        - *fetch_scripts
    script:
        - bash "${_SCRIPTS_DIR}/scripts/dependency_track_upload.sh"
    artifacts:
        paths:
            - "$DEFECTDOJO_SCAN_FILE"
