ARG NODE_IMAGE_V20=example.registry/shop-app-infra/images/node:20-alpine
ARG NGINX_IMAGE=example.registry/shop-app-infra/images/nginx:1.21.0-alpine
ARG NPM_COMMAND="npm run build"
ARG E2E_TEST_BASE_URL=https://e2e.example.com
ARG E2E_TEST_NAMES

FROM $NODE_IMAGE_V20 AS builder

ENV CI=true
ENV E2E_TEST_BASE_URL=$E2E_TEST_BASE_URL
ENV E2E_TEST_NAMES=$E2E_TEST_NAMES
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

ENV E2E_STAND=e2e
ENV E2E_OPERATOR_LOGIN=CHANGE_ME
ENV E2E_OPERATOR_PASSWORD=CHANGE_ME
ENV E2E_CLIENT_LOGIN=CHANGE_ME
ENV E2E_CLIENT_PASSWORD=CHANGE_ME
ENV E2E_PARTNER_LOGIN=CHANGE_ME
ENV E2E_PARTNER_PASSWORD=CHANGE_ME
ENV E2E_VK_LOGIN=CHANGE_ME
ENV E2E_VK_PASSWORD=CHANGE_ME
ENV DEV4_VK_LOGIN=
ENV DEV4_VK_PASSWORD=

WORKDIR /app
COPY . /app

RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont
RUN npm ci --force && npm run test:e2e
