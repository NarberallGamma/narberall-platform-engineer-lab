# -*- mode: crontab -*-
# vi: set ft=crontab :
#
# Production runner. Same job mix as the live estate, hosts rewritten.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# kube-master etcd
10 2 * * * /app/00-scripts/borg_run_on.sh 10.10.20.21 borg_backup_etcd.sh

# mysql-report-0 binlog
1 * * * * /app/00-scripts/borg_run_on.sh mysql-report-0.estate.example.com borg_backup_files.sh 'BINLOG /var/lib/mysql/binlogs/mysql8-bin.*'

# mysql-report-1 xtrabackup + binlog
11 22 * * * /app/00-scripts/borg_run_on.sh mysql-report-1.estate.example.com borg_backup_xtrabackup.sh 'MYSQL --defaults-file "~/.my.cnf"'
10 * * * * /app/00-scripts/borg_run_on.sh mysql-report-1.estate.example.com borg_backup_files.sh 'BINLOG /var/lib/mysql/binlogs/mysql8-bin.*'

# mysql-app-0 binlog
21 * * * * /app/00-scripts/borg_run_on.sh mysql-app-0.estate.example.com borg_backup_files.sh 'BINLOG /var/lib/mysql/binlogs/mysql8-bin.*'

# mysql-app-1 xtrabackup + binlog
28 22 * * * /app/00-scripts/borg_run_on.sh mysql-app-1.estate.example.com borg_backup_xtrabackup.sh 'MYSQL --defaults-file "~/.my.cnf"'
46 * * * * /app/00-scripts/borg_run_on.sh mysql-app-1.estate.example.com borg_backup_files.sh 'BINLOG /var/lib/mysql/binlog*'

# mysql-app-2 binlog
49 * * * * /app/00-scripts/borg_run_on.sh mysql-app-2.estate.example.com borg_backup_files.sh 'BINLOG /var/lib/mysql/binlog*'

# mysql-legacy-0 binlog
45 * * * * /app/00-scripts/borg_run_on.sh mysql-legacy-0.estate.example.com borg_backup_files.sh 'BINLOG /mnt/binlogs --prune "--keep-within=7d"'

# mysql-legacy-1 xtrabackup + binlog
