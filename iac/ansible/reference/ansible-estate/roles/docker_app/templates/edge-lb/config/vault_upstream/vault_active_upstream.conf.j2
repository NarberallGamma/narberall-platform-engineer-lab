# Managed by Ansible (docker_app edge-lb). Initial upstream; sidecar updates when edge_lb_vault_upstream_sidecar_enabled.
# File is included from the upstream block in vault.conf, not from conf.d (otherwise nginx loads server at the http level).
{% if edge_lb_vault_upstream_sidecar_enabled | default(false) %}
# vault-upstream sidecar overwrites after probe ?standbyok=false (bootstrap: first node)
{% set bootstrap_node = edge_lb_vault_backends | first %}
    server {{ bootstrap_node.ip }}:{{ bootstrap_node.port | default(8200) }};  # bootstrap {{ bootstrap_node.name | default(bootstrap_node.ip) }}
{% else %}
{% for node in edge_lb_vault_backends %}
    server {{ node.ip }}:{{ node.port | default(8200) }};
{% endfor %}
{% endif %}
