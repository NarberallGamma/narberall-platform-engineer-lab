# SSH tunnel user: {{ tunnel_user }}
# Jump: {{ ansible_host }}  |  socat: 127.0.0.1:{{ xui_ssh_tunnel_listen_port }} → {{ xui_ssh_tunnel_target_host_effective }}:{{ xui_ssh_tunnel_target_port }}

