services:
  nginx:
    image: {{ app_item.value.image }}
    container_name: gitlab-nginx
    restart: always
    network_mode: host
    volumes:
      - ./config:/etc/nginx/conf.d:ro
      - ./certs:/etc/nginx/certs:ro
      - ./logs:/var/log/nginx
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    logging:
      options:
        max-size: "50m"
        max-file: "1"
