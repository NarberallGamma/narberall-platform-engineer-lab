# Ansible: запасной канал SSH-туннеля (socat localhost → main)
[Unit]
Description=SSH tunnel socat forward ({{ xui_ssh_tunnel_listen_bind }}:{{ xui_ssh_tunnel_listen_port }} → {{ xui_ssh_tunnel_target_host_effective }}:{{ xui_ssh_tunnel_target_port }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:{{ xui_ssh_tunnel_listen_port }},bind={{ xui_ssh_tunnel_listen_bind }},fork,reuseaddr TCP:{{ xui_ssh_tunnel_target_host_effective }}:{{ xui_ssh_tunnel_target_port }}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
