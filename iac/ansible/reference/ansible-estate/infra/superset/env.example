# Скопировать в .env рядом с docker-compose.yml и заполнить.
# Секреты не коммитировать.

COMPOSE_PROJECT_NAME=estate-superset

# Образ Docker Hub (тег = релиз Superset). Актуальный stable: https://github.com/apache/superset/releases
SUPERSET_IMAGE=apache/superset:6.0.0

# --- Superset (pythonpath/superset_config.py, через env_file в compose) ---

# Обязательно: openssl rand -base64 42
SUPERSET_SECRET_KEY=

# Пароль пользователя PostgreSQL в контейнере db (пользователь superset, БД superset).
# Без символов @ : / ? # в значении (иначе сломается подстановка в SQLALCHEMY_DATABASE_URI в compose).
POSTGRES_PASSWORD=

# SQLALCHEMY_DATABASE_URI и REDIS_URL задаются в docker-compose.yml (хосты db и redis).
# Переопределение: добавить переменные в .env и в блок environment у сервисов superset* в compose.

# --- Первый запуск: docker compose --profile init run --rm superset-init ---

# Пароль первого администратора. В образе 6.0.0 docker-init.sh создаёт пользователя
# admin / admin@superset.com с этим паролем (имя и email зашиты в скрипте upstream).
ADMIN_PASSWORD=

# --- Режим (docker-init и приложение читают из .env) ---

SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
FLASK_DEBUG=false

# --- Аутентификация: db (только локальные пользователи) или oauth (ADFS OIDC) ---
# db — без ADFS, подходит для отладки. oauth — прод: задать OAUTH_CLIENT_* ниже.
SUPERSET_AUTH_TYPE=db

# Регистрация при первом входе через OAuth; роль по умолчанию, если группа ADFS не сматчилась
AUTH_USER_REGISTRATION_ROLE=Public
AUTH_ROLES_SYNC_AT_LOGIN=true

# Конфиденциальные данные приложения ADFS (OIDC) — выдать в ADFS, не коммитить
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Метаданные OIDC ADFS (при необходимости заменить на другой хост)
OAUTH_SERVER_METADATA_URL=https://adfs.example.com/adfs/.well-known/openid-configuration

# Только для отладки при HTTP к IdP (в проде обычно 0)
OAUTHLIB_INSECURE_TRANSPORT=0

# Резолв имени ADFS на внутренний IP (split-DNS). Формат host:ip. Пустое значение в compose не поддерживается —
# при необходимости убрать extra_hosts через override-файл.
ADFS_EXTRA_HOST_ENTRY=adfs.example.com:10.10.12.4
