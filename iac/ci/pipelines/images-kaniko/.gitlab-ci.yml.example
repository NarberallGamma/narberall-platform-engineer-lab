# Pin public images into the project registry via Kaniko.
# Manual jobs. If the version folder has no Dockerfile, write a one-line FROM retag.

stages:
  - build

variables:
  APP_VERSION: "1.0.0"

.default_kaniko_template: &kaniko_template
  stage: build
  image:
    name: gcr.io/kaniko-project/executor:v1.24.0-debug
    entrypoint: [""]
  before_script:
    - mkdir -p /kaniko/.docker
    - |
      cat > /kaniko/.docker/config.json <<EOF
      {
        "auths": {
          "$CI_REGISTRY": {
            "username": "$CI_REGISTRY_USER",
            "password": "$CI_REGISTRY_PASSWORD"
          }
        }
      }
      EOF

  script:
    - |
      if [ ! -f "$CI_PROJECT_DIR/$NAME/$VER/Dockerfile" ]; then
        echo "Folder $NAME or Dockerfile missing. Creating a one-line Dockerfile."
        mkdir -p "$CI_PROJECT_DIR/$NAME/$VER"
        echo "FROM $NAME:$VER" > "$CI_PROJECT_DIR/$NAME/$VER/Dockerfile"
      fi

    - echo "Building $NAME with version $VER"
    - |
      echo /kaniko/executor \
        --context "$CI_PROJECT_DIR/$NAME/$VER" \
        --dockerfile "$CI_PROJECT_DIR/$NAME/$VER/Dockerfile" \
        --destination "$CI_REGISTRY_IMAGE/$NAME:$VER-$CI_COMMIT_SHORT_SHA" \
        --destination "$CI_REGISTRY_IMAGE/$NAME:$VER" \
        --build-arg VER=$VER \
        --cache=false
    - PUSH_NAME=$(echo "$NAME" | sed 's/[\.\/]/-/g')
    - |
      /kaniko/executor \
        --context "$CI_PROJECT_DIR/$NAME/$VER" \
        --dockerfile "$CI_PROJECT_DIR/$NAME/$VER/Dockerfile" \
        --destination "$CI_REGISTRY_IMAGE/$PUSH_NAME:$VER-$CI_COMMIT_SHORT_SHA" \
        --destination "$CI_REGISTRY_IMAGE/$PUSH_NAME:$VER" \
        --build-arg VER=$VER \
        --cache=false

  when: manual
  tags:
    - k8s-kaniko

vault:
  <<: *kaniko_template
  variables:
    NAME: "hashicorp/vault"
    VER: "1.18.2"

kafka:
  <<: *kaniko_template
  variables:
    NAME: "apache/kafka"
    VER: "4.0.0"

