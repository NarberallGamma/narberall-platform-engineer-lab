{{/* Compact sec-stack Telegram messages (parse_mode HTML).
     Telegram 4096-character limit -> show at most 8 alerts from the group. */}}
{{ define "sec-stack.telegram" }}
{{- if .Alerts.Firing }}
{{- if eq .CommonLabels.severity "critical" }}🔴{{ else }}🟠{{ end }} <b>{{ .CommonLabels.alertname }}</b> — firing: {{ len .Alerts.Firing }}
{{- range $i, $a := .Alerts.Firing }}
{{- if lt $i 8 }}
▪️ {{ $a.Annotations.summary }}{{ if $a.GeneratorURL }} <a href="{{ $a.GeneratorURL }}">📈</a>{{ end }}
{{- end }}
{{- end }}
{{- if gt (len .Alerts.Firing) 8 }}
<i>…showing 8 of {{ len .Alerts.Firing }}, full list — <a href="http://10.10.1.10:3000/d/sec-stack-overview">on the dashboard</a></i>
{{- end }}
{{- end }}
{{- if .Alerts.Resolved }}
✅ <b>{{ .CommonLabels.alertname }}</b> — resolved: {{ len .Alerts.Resolved }}
{{- range $i, $a := .Alerts.Resolved }}
{{- if lt $i 8 }}
▪️ {{ $a.Annotations.summary }}
{{- end }}
{{- end }}
{{- end }}
{{ end }}
