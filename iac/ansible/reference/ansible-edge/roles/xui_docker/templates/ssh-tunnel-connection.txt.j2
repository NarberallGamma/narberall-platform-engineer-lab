Linux / macOS:
  ssh -i "ssh-tunnel/keys/{{ tunnel_user }}" -N -o ServerAliveInterval=60 -o ExitOnForwardFailure=yes -L {{ xui_ssh_tunnel_client_local_port }}:127.0.0.1:{{ xui_ssh_tunnel_listen_port }} {{ tunnel_user }}@{{ ansible_host }}

