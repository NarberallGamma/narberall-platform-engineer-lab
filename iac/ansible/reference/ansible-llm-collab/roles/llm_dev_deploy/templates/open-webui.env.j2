# Управляется Ansible — секреты контейнера Open WebUI (env_file).
{% set _wu = llm_dev_nginx_path_webui | default('/') %}
{% if _wu == '/' or _wu == '' %}
{% set webui_suffix = '' %}
{% else %}
{% set webui_suffix = '/' ~ (_wu | regex_replace('^/', '') | regex_replace('/$', '')) %}
{% endif %}
WEBUI_SECRET_KEY={{ llm_dev_webui_secret_key }}
{% if llm_dev_open_webui_public_url | default('') | length > 0 %}
{% set pub = llm_dev_open_webui_public_url | regex_replace('/$', '') %}
WEBUI_URL={{ pub }}{{ webui_suffix }}
{% endif %}
OPENAI_API_BASE_URL=http://llama-server:{{ llm_dev_listen_port }}/v1
{% if llm_dev_enable_api_key | bool %}
OPENAI_API_KEY={{ llm_dev_api_key }}
{% else %}
OPENAI_API_KEY=
{% endif %}
