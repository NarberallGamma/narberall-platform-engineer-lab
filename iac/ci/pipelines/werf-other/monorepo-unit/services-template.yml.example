spec:
  inputs:
    service_release_name:
      description: release name
      default: ""
    service_directory:
      description: directory of the service or library
    service_helm_directory:
      description: directory with Helm charts for the service or library
    service_changes_paths:
      type: array
      default:
        - "**/*"
      description: paths watched for changes (list of directories)
    service_cov_variable:
      description: variable that starts tests on a manual job run (example RELOAD_COV_LIB_AUTOTEST_API)
    service_test_coverage:
      description: regular expression for coverage in tests
      default: '/(?i)total.*? (100(?:\.0+)?\%|[1-9]?\d(?:\.\d+)?\%)$/'
    service_test_image_name:
      description: image name from the environment (example $WERF_PORTAL_API_DOCKER_IMAGE_NAME)
      default: "bash"
    service_test_before_script:
      description: commands to run in before_script when tests start
      type: array
      default:
        - export CURRENT=$(pwd)
    service_test_artifacts_paths:
      description: files uploaded as artifacts after tests
      type: array
      default: [coverage.json]
    service_test_coverage_reports_path:
      type: string
      default: coverage.xml
    service_test_artifacts_reports_junit:
      type: string
      default: pytest.xml
    service_disable_tests_buttons:
      description: disable the test include; set to ".disabled-" to turn off
      default: ""
      options: ["", ".disabled-"]
    service_disable_production:
      description: disable the deploy-to-production job
      default: ""
      options: ["", ".disabled-"]
    service_disable_dev:
      description: disable the deploy-to-dev job
      default: ".disabled-"
      options: ["", ".disabled-"]
    service_disable_secondary:
      description: disable the deploy-to-secondary-cluster job
      default: ""
      options: ["", ".disabled-"]
    service_disable_cleanup:
      description: disable cleanup; set to ".disabled-" to turn off
      default: ""
      options: ["", ".disabled-"]
    service_type:
      description: service or library (used in job names only)
      default: "service"
      options: ["service", "library"]
    cleanup_options:
      description: extra cleanup flags, for example --keep-list=keep-list.txt
      default: ""
---
variables:
  $[[ inputs.service_cov_variable ]]:
    description: $[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]
    options:
      - "true"
      - "false"
    value: "false"
  $[[ inputs.service_cov_variable ]]_CRON:
    description: $[[ inputs.service_type ]]/$[[ inputs.service_cov_variable ]]_CRON
    options:
      - "true"
      - "false"
    value: "false"

# Catalog flatten: script-test.yml.example sits in this mini-root (not $helm_directory/script-test.yml).
$[[ inputs.service_disable_tests_buttons ]]include:
  - local: script-test.yml.example
    inputs:
      test_name: .base_test_$[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]

.base_$[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]:
  variables:
    RELEASE_NAME: $[[ inputs.service_release_name ]]
    HELM_DIRECTORY: "$[[ inputs.service_helm_directory ]]"
    WERF_CONFIG: "$[[ inputs.service_helm_directory ]]/werf.yaml"
  needs:
    - job: Build
    - job: Build $[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]
      artifacts: true
      optional: true

# These rules are repeated because rules: !reference [$[[ inputs.job-name ]], rules] is not available yet.
# Track https://gitlab.com/gitlab-org/gitlab/-/issues/424481

.rules_$[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]:
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH && $CI_PIPELINE_SOURCE != "merge_request_event" && $CI_PIPELINE_SOURCE != "schedule" && $START_ALL_TESTS == "true"
      changes:
        paths: $[[ inputs.service_changes_paths ]]
    - if: $CI_COMMIT_BRANCH != $CI_DEFAULT_BRANCH && $CI_PIPELINE_SOURCE != "schedule"
      changes:
        compare_to: "refs/heads/master"
        paths: $[[ inputs.service_changes_paths ]]
    - if: $$[[ inputs.service_cov_variable ]] == "true" && $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
    - if: $TESTS_SCHEDULE_ENABLED == "true"
    - when: never

Build $[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]:
  extends:
    - .base_$[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]
    - .base_builds
    - .rules_$[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]

.base_test_$[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]:
  variables:
    DIR: $[[ inputs.service_directory ]]
    GIT_STRATEGY: "fetch"
  image:
    name: $[[ inputs.service_test_image_name ]]
    entrypoint: [""]
  stage: test
  tags:
    - docker
    - test
  allow_failure: false
  before_script: $[[ inputs.service_test_before_script ]]
  coverage: $[[ inputs.service_test_coverage ]]
  artifacts:
    reports:
      junit: $[[ inputs.service_test_artifacts_reports_junit ]]
      coverage_report:
        coverage_format: cobertura
        path: $[[ inputs.service_test_coverage_reports_path ]]
    paths: $[[ inputs.service_test_artifacts_paths ]]
  interruptible: true

$[[ inputs.service_disable_tests_buttons ]]Test $[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]:
  extends:
    - .base_$[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]
    - .base_test_$[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]
    - .rules_$[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]
    - .postgres_variables
    - .rabbitmq_variables

$[[ inputs.service_disable_dev ]]$[[ inputs.service_release_name ]] to DEV deploy:
  extends:
    - .multi_deploy_to_dev
    - .base_$[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule" && $$[[ inputs.service_cov_variable ]]_CRON == "true"
      when: always
    - if: $CI_PIPELINE_SOURCE != "schedule"
      allow_failure: true
      when: manual
    - when: never
  environment:
    name: dev-$[[ inputs.service_release_name ]]

$[[ inputs.service_disable_secondary ]]$[[ inputs.service_release_name ]] to DEV-secondary deploy:
  extends:
    - .multi_deploy_to_dev_secondary
    - .base_$[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule" && $$[[ inputs.service_cov_variable ]]_CRON == "true"
      when: always
    - if: $CI_PIPELINE_SOURCE != "schedule"
      allow_failure: true
      when: manual
  environment:
    name: dev-secondary-$[[ inputs.service_release_name ]]

$[[ inputs.service_disable_production ]]$[[ inputs.service_release_name ]] to Production deploy:
  extends:
    - .multi_deploy_to_production
    - .base_$[[ inputs.service_type ]]/$[[ inputs.service_release_name ]]
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule" && $$[[ inputs.service_cov_variable ]]_CRON == "true"
      when: always
    - if: $CI_PIPELINE_SOURCE != "schedule" && ( $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH || $CI_COMMIT_REF_NAME =~ /^infra.*$/)
      allow_failure: true
      when: manual
  environment:
    name: production-$[[ inputs.service_release_name ]]

$[[ inputs.service_disable_cleanup ]]Cleanup $[[ inputs.service_release_name ]]:
  variables:
    RELEASE_NAME: $[[ inputs.service_release_name ]]
    HELM_DIRECTORY: "$[[ inputs.service_helm_directory ]]"
    WERF_CONFIG: "$[[ inputs.service_helm_directory ]]/werf.yaml"
    CLEANUP_OPTIONS: "$[[ inputs.cleanup_options ]]"
  extends:
    - .base_cleanup

.postgres_variables: &postgres_variables
  variables:
    POSTGRES_DB: "db-test"
    POSTGRES_USER: "postgres"
    POSTGRES_PASSWORD: "CHANGE_ME"

.rabbitmq_variables: &rabbitmq_variables
  variables:
    RABBITMQ_DEFAULT_USER: "rabbitmq"
    RABBITMQ_DEFAULT_PASS: "CHANGE_ME"

.additional_services:
  postgres:
    name: postgres:13
    alias: postgres
  rabbitmq:
    name: rabbitmq:3.9.23-management
    alias: rabbitmq
