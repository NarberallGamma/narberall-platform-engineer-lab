    - https://{{ idplat_public_hostname }}:{{ igext_https_published_port }}/openId/callback
    - http://{{ idplat_public_hostname }}:{{ ig_published_port }}/openId/callback
    - https://{{ idplat_public_hostname }}:{{ ig_https_published_port }}/openId/callback
