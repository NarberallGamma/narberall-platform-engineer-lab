# Backup the test database and upload the dump to object storage.
backup-db:
  image: alpine:latest
  stage: backup
  before_script:
    - apk add --no-cache postgresql-client s3cmd
    - |
      cat <<EOL > /root/.s3cfg
      [default]
      access_key = $ACCESS_KEY
      secret_key = $SECRET_KEY
      host_base = obs.example.com
      host_bucket = %(bucket)s.obs.example.com
      use_https = True
      signature_v2 = No
      EOL
  script:
    - export PGPASSWORD=$PGPASSWORD
    - DUMP_FILE="shop_app_test_backup_$(date +%Y_%m_%d_%H_%M).sql"
    - echo "Creating a database dump for the test environment..."
    - pg_dump --verbose -h 10.10.0.20 -p 5432 -U app -d shop_app_test > "$DUMP_FILE"
    - |
      echo "Dump created, file size: $(stat -c%s "$DUMP_FILE") bytes"
      echo "Uploading the dump to object storage..."
      s3cmd put "$DUMP_FILE" s3://backup-test.example/

  tags:
    - docker
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      when: never
    - if: '$GITLAB_USER_LOGIN =~ /^(ci-operator|release-bot)$/'
      when: on_success
    - when: never
  needs:
    - job: test
    - job: setenv
      artifacts: true
      optional: true
