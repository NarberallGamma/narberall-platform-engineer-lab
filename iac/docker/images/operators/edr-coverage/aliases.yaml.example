# Ручные соответствия «хост -> имя агента в EDR».
#
# Нужны там, где связь есть, но в данных её нет. Главный случай — маки в домене:
# агент регистрируется под локальным именем ('MacBook-Air-admin.local'), а если
# сетевое имя выглядит как IP-адрес, macOS режет его по первой точке, и в EDR
# приезжает '192'. Доменного имени нет ни в одном поле API, никаким ключом это
# не сшивается.
#
# Автоматически по имени пользователя merge3 такие пары НЕ сопоставляет: второй
# ноутбук у того же человека молча испортил бы метрику. Вместо этого он пишет
# кандидатов в лог — строка «Кандидаты в aliases.yaml (совпал пользователь…)».
# проверить глазами в панели EDR и перенести сюда.
#
# Имя агента — то, что лежит в колонке name файла {company}_edr.csv (регистр и
# подчёркивания не важны). Если агента с таким именем в выгрузке нет, merge3
# предупредит: скорее всего, агент переустановлен и запись протухла.
#
# Для обрезанных имён ссылаться на displayname, а не на name: под именем '192'
# сидят три разных мака, и merge3 различает их именно по displayname
# (192.168.1.11 / .15 / .8) — так соответствие указывает на конкретную машину.

companies:
  project-e:
    m-user-a: MAC             # Mac.loc, lastuser a.user
    m-user-b: 192.168.1.15    # в панели виден так, name обрезан до '192'

  project-c:
    m-proj-c-00020: M-PROJ-C-00020-1
