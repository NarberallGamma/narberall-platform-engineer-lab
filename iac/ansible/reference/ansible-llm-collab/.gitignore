# Ansible artifacts (hold sensitive data and binaries)
artifacts/

# Ansible collections cache
.collections/

# Ansible retry files
*.retry

# Ansible vault files (when used)
*.vault

# Local variables (when used)
vars.local.yml

# Vault env (generated by the pipeline from CI Variables on the control node; never commit)
.env.vault

# Local copies of .env pulled from hosts (Kafka and others); never commit
.env
!.env.example

# Ansible private SSH key (rolled out by the pipeline from ANSIBLE_SSH_PRIVATE_KEY)
.ssh/

# Temporary file for client_name when calling run_nextcloud_groupfolders.sh "Name With Spaces"
.ansible_client_vars.json

# Temporary file for the private SSH key
.ssh_key_mount

# Live inventory / secrets (publish *.example only)
hosts.ini
inventories/hosts.ini
passwd.yaml
**/passwd.yaml
*.pem
*.key
*.pfx
**/secrets.sops.yml
!**/secrets.sops.yml.example
