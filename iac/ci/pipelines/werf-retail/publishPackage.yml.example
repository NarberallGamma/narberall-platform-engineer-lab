.base_publish: &base_publish
  stage: publish
  when: manual
  variables:
    WERF_NAMESPACE: publish-packages
    WORK_DIR: "/src" # working directory inside the builder image
    BUILD_IMAGE: "build" # builder image name; override in the consumer pipeline
    PROJECT_PATH: "somepackage" # package path to publish
    WERF_KUBE_CONTEXT: dev
    WERF_ADD_LABEL_1: COMMIT-SHA=${CI_COMMIT_SHA}
    KUBERNETES_CPU_REQUEST: "0.2"
    KUBERNETES_MEMORY_REQUEST: "256Mi"
  dependencies:
    - Build
  tags:
    - docker
  extends: ".base_werf"
  script:
    - set -x
    - export CI_COMMIT_TIMESTAMP_UNIX=$(date -d "$CI_COMMIT_TIMESTAMP" +%s 2>/dev/null || echo "")
    - |
      export CI_VARIABLES=$(env | grep -E '^CI_COMMIT_REF_SLUG=|^CI_PIPELINE_ID=|^CI_COMMIT_TIMESTAMP_UNIX=' | awk -F= '{print "{\"name\": \"" $1 "\", \"value\": \"" $2 "\"}"}' | paste -sd "," -)
    - |
      werf kube-run --overrides "{\"spec\":{\"containers\":[{\"name\":\"%container_name%\",\"env\":[${CI_VARIABLES}]}]}}" ${BUILD_IMAGE} -- bash -c "
          cd /src;
          dotnet pack \"${PROJECT_PATH}\" --no-build -c Release -o pkgs $( [[ -z $BUILD_PATH ]] || printf '/p:OutputPath=\"%s\"' $BUILD_PATH);

          dotnet nuget update source gitlab -s "https://gitlab.example.com/api/v4/projects/1/packages/nuget/index.json" --username gitlab-ci-token --password $CI_JOB_TOKEN --store-password-in-clear-text;

          packages=\$(find ./pkgs -type f -name *.nupkg);
          for package in \${packages}; do
              echo \"[INFO] Package: \${package}\";
              package_basename=\$( basename \${package} );

              regex_feature='^(.*)\.((20[0-9]{2}\.[0-9]+(\.[0-9]+){2,})[-a-zA-Z0-9]*)\.nupkg$'
              regex_semver='^(.*)\.(([0-9]+(\.[0-9]+){2,})[-a-zA-Z0-9]*)\.nupkg$'

              if [[ \${package_basename} =~ \${regex_feature} ]]; then
                  package_name=\${BASH_REMATCH[1]};
                  package_version=\${BASH_REMATCH[2]};
                  echo \"[INFO] Package name: \${package_name}\"
                  echo \"[INFO] Package version: \${package_version}\"
              elif [[ \${package_basename} =~ \${regex_semver} ]]; then
                  package_name=\${BASH_REMATCH[1]};
                  package_version=\${BASH_REMATCH[2]};
                  echo \"[INFO] Package name: \${package_name}\"
                  echo \"[INFO] Package version: \${package_version}\"
              else
                  echo; echo \"[ERROR] Error to parse package name/version, exiting...\"; exit 1;
              fi
              echo "---"
              echo \"[INFO] Check if package already exists in gitlab package repo:\";
              wget -qO- --content-on-error --user gitlab-ci-token --password ${CI_JOB_TOKEN} \"https://gitlab.example.com/api/v4/projects/1/packages/nuget/metadata/\${package_name,,}/\${package_version}\" || {
                  echo; echo \"[INFO] Package not found in gitlab, pushing new package...\";
                  dotnet nuget push \${package} --source gitlab;echo \"[INFO] Verifying package was published successfully...\";
                  max_attempts=3
                  attempt=1
                  verification_success=false
                  while [ \$attempt -le \$max_attempts ]; do
                      echo \"[INFO] Verification attempt \$attempt of \$max_attempts\";
                      if wget -qO- --user gitlab-ci-token --password ${CI_JOB_TOKEN} \"https://gitlab.example.com/api/v4/projects/1/packages/nuget/metadata/\${package_name,,}/\${package_version}\"; then
                          echo \"[INFO] Package verification successful!\";
                          break;
                      fi
                      echo \"[INFO] Package not found yet, waiting...\";
                      sleep 5;
                      attempt=\$((attempt + 1));
                  done
                  if [ \$attempt -gt \$max_attempts ]; then
                      echo \"\\e[31m[ERROR] Failed to verify package publication after \$max_attempts attempts\\e[0m\";
                      echo \"\\e[31m[ERROR] No access to the package project https://gitlab.example.com/shop-app/utils/nugets\\e[0m\";
                      exit 1;
                  fi
              } || {
                  echo; echo \"[ERROR] Package \${package} already exists in gitlab, exiting...\"; exit 1;
              }
          done
      "
  after_script:
    - werf kubectl -n ${WERF_NAMESPACE} delete pod -l COMMIT-SHA=${CI_COMMIT_SHA}
    - werf kubectl -n ${WERF_NAMESPACE} get secrets  --no-headers=true |grep 'werf-run' | awk '/[0-9]+d/{print $4" "$1}' |awk '{print $2}'  |xargs |xargs  werf kubectl -n ${WERF_NAMESPACE} delete secret || true
  except:
    - schedules
    - pipelines
