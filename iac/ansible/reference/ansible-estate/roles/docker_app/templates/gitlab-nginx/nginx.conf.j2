user nginx;
worker_processes auto;

error_log /var/log/nginx/error.log warn;
error_log /dev/stderr warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

{% if app_item.value.ssh_proxy_enabled | default(false) | bool %}
stream {
    log_format stream '$remote_addr [$time_local] $protocol $status';
    access_log /var/log/nginx/{{ app_item.value.gitlab_host }}/ssh.log stream;

    upstream gitlab_ssh {
        server 127.0.0.1:22;
    }

    server {
        listen {{ app_item.value.listen_address | default('0.0.0.0') }}:{{ app_item.value.ssh_listen_port | default(2222) }};
        proxy_pass gitlab_ssh;
        proxy_connect_timeout 10s;
        proxy_timeout 1h;
    }
}
{% endif %}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" host=$server_name';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    keepalive_timeout 65;

    include /etc/nginx/conf.d/*.conf;
}
