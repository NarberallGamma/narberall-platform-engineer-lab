include:
  - local: 'common.yml.example'

.base_image: &base_image
  stage: replace
  image: $WERF_BUILD_DOCKER_IMAGE_NAME
  needs:
    - job: Build
      artifacts: true
  tags: [docker]

.base_publish_nexus: &base_publish_nexus
  extends:
    - .base_image
  stage: publish
  rules:
    - !reference [.rule_not_schedule]
    - !reference [.rule_production]
    - when: never
  tags: [ docker ]
  script:
    - mkdir -p ~/bin
    - | # Install jq
      type jq || wget https://github.com/stedolan/jq/releases/download/jq-1.6/jq-linux64 -O /bin/jq
      chmod +x /bin/jq || true

    - apt-get install git
    - git config user.email "ci-bot@example.com"
    - git config user.name "ci-bot"
    - |
      git remote remove gitlab_origin || true
      git remote add gitlab_origin https://oauth2:$CI_BOT_TOKEN@$CI_SERVER_HOST/$CI_PROJECT_PATH.git || true
    - npm config set registry https://nexus.example.com/repository/npm-private/
    - npm config set always-auth true
    - npm config set //nexus.example.com/repository/npm-private/:_authToken=CHANGE_ME
    - pwd
    - cp -r /app/dist/ .
    - cp -r /app/node_modules/ .
    - ls -l 
    - | # patch version
      json="$(cat package.json )"
      version=$(echo $json |jq -r .version)
      IFS='.' read -r -a version <<< "$version"
      if [ "$CHANGE_VERSION" = "major" ] ; then version[0]=$((1 + version[0])) ; version[1]=0; version[2]=0;
      elif [ "$CHANGE_VERSION" = "minor" ] ; then version[1]=$((1 + version[1])) ; version[2]=0;
      elif [ "$CHANGE_VERSION" = "patch" ] ; then version[2]=$((1+ version[2])) ;
      fi
      echo "$json" |jq ".version= \"${version[0]}.${version[1]}.${version[2]}\"" >package.json
    - git add package.json
    - |
      [[ -z $(git status -uno --porcelain) ]] && echo "no need to push..." && exit 250
    - git commit -m "[CI Bot] $CI_JOB_NAME version \"${version[0]}.${version[1]}.${version[2]}\""
    - git push gitlab_origin HEAD:$CI_COMMIT_REF_NAME -o ci.skip
    - npm publish
  needs:
    - !reference [.needs_converge]

Npm publish major version:
  variables:
    CHANGE_VERSION: major
  extends:
    - .base_publish_nexus

Npm publish minor version:
  variables:
    CHANGE_VERSION: minor
  extends:
    - .base_publish_nexus

Npm publish patch version:
  variables:
    CHANGE_VERSION: patch
  extends:
    - .base_publish_nexus


Npm publish nexus:
  image: mirror.gcr.io/node:16-alpine
  stage: publish
  rules:
    - !reference [.rule_not_schedule]
    - when: manual
  tags: [ docker ]
  when: manual
  needs:
    - !reference [.needs_converge]
  script:
    - npm config set registry https://nexus.example.com/repository/npm-private/
    - npm config set always-auth true
    - npm config set //nexus.example.com/repository/npm-private/:_authToken=CHANGE_ME
    - npm publish
