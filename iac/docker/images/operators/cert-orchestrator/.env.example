# Copy to .env and fill in values. Do not commit .env.

# Image from the registry (preprod / prod — per environment)
CERT_ORCHESTRATOR_IMAGE=example.registry/estate/base-images/cert-orchestrator:1.1

TZ=Europe/Moscow

# Host config file (copy from example-config.yaml)
HOST_CONFIG_PATH=./config.yaml

# certbot directory on the host
HOST_LETSENCRYPT_PATH=/etc/letsencrypt

# K8s cluster CA (PEM), mounted at /run/cert-orchestrator/k8s-ca.crt
HOST_K8S_CA_PATH=./k8s-ca.crt

# Private SSH key for nginx_remotes
HOST_SSH_KEY=/home/user/.ssh/id_estate

# ServiceAccount token (kubectl --token)
K8S_TOKEN=CHANGE_ME

# Optional: override REG.RU from YAML
# REG_RU_DNS_USERNAME=CHANGE_ME
# REG_RU_DNS_PASSWORD=CHANGE_ME

# Optional: Telegram (overrides empty YAML fields)
# TELEGRAM_BOT_TOKEN=CHANGE_ME
# TELEGRAM_CHAT_IDS=-1000000000001
