image: docker:20.10

variables:
  DOCKER_HOST: tcp://docker:2375
  DOCKER_TLS_CERTDIR: ""
  REGISTRY_URL: "example.registry"
  IMAGE_TAG: ${REGISTRY_URL}/apps/llm-api:latest

stages:
  - build
  - deploy
  - security-test

build:llm-api:
  stage: build
  only:
    - main
  when: manual
  tags:
    - docker
  before_script:
    - echo "=== waiting for the Docker daemon ==="
    - timeout 30 sh -c 'while ! docker info >/dev/null 2>&1; do sleep 1; done' || echo "Docker daemon did not become ready"
    - docker version
    - docker info
    - docker login -u $CI_REGISTRY_USER -p $CI_REGISTRY_PASSWORD $REGISTRY_URL
  script:
    - docker build -t $IMAGE_TAG ./llm-api/
    - docker push $IMAGE_TAG

build:fleet-watcher:
  stage: build
  only:
    - main
  when: manual
  tags:
    - docker
  before_script:
    - echo "=== waiting for the Docker daemon ==="
    - timeout 30 sh -c 'while ! docker info >/dev/null 2>&1; do sleep 1; done' || echo "Docker daemon did not become ready"
    - docker version
    - docker info
    - docker login -u $CI_REGISTRY_USER -p $CI_REGISTRY_PASSWORD $REGISTRY_URL
  script:
    - docker build --network host -t ${REGISTRY_URL}/apps/fleet-watcher:latest ./fleet-watcher/
    - docker push ${REGISTRY_URL}/apps/fleet-watcher:latest

deploy:
  stage: deploy
  image: ${REGISTRY_URL}/ci/helmfile:latest
  only:
    - main
  when: manual
  tags:
    - docker
  script:
    - helmfile apply -f stands/dev-stand-llm/helmfile.yaml

security-test:
  stage: security-test
  needs: []
  trigger:
    include:
      - project: "security/security-gates"
        ref: "main"
        file: "templates/security-pipeline.yml.example"
  inherit:
    variables: true
