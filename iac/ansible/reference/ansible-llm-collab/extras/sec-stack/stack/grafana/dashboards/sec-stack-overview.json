{
  "title": "sec-stack overview",
  "uid": "sec-stack-overview",
  "tags": ["sec-stack"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Таргеты up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "count(up == 1)", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "noValue": "0" }, "overrides": [] }
    },
    {
      "id": 2, "type": "stat", "title": "Таргеты down",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "count(up == 0) or vector(0)", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "PAN-OS живы (по API)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "sum(panos_up)", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "noValue": "0", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 8 } ] } }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "Пробы blackbox ок",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "count(probe_success == 1) or vector(0)", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "noValue": "0" }, "overrides": [] }
    },
    {
      "id": 5, "type": "stat", "title": "Алерты firing (кроме heartbeat)",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "count(ALERTS{alertstate=\"firing\", alertname!=\"DeadManSwitch\"}) or vector(0)", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "noValue": "0", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] } }, "overrides": [] }
    },
    {
      "id": 6, "type": "bargauge", "title": "Сертификаты: дней до истечения",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "(probe_ssl_earliest_cert_expiry - time()) / 86400", "legendFormat": "{{probe_target}}", "instant": true, "refId": "A" },
        { "expr": "(panos_certificate_expiry_timestamp_seconds - time()) / 86400", "legendFormat": "{{firewall}}: {{certificate}}", "instant": true, "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "d", "min": 0, "max": 400, "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 7 }, { "color": "yellow", "value": 30 }, { "color": "green", "value": 60 } ] } }, "overrides": [] }
    },
    {
      "id": 7, "type": "table", "title": "Алерты сейчас",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "ALERTS{alertname!=\"DeadManSwitch\"}", "instant": true, "format": "table", "refId": "A" }],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true }, "indexByName": { "alertname": 0, "alertstate": 1, "severity": 2 } } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 8, "type": "timeseries", "title": "PAN-OS: доступность по API (panos_up)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "panos_up", "legendFormat": "{{firewall}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "none" } } }, "overrides": [] }
    },
    {
      "id": 9, "type": "timeseries", "title": "IPsec-туннели (panos_ipsec_tunnel_up)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "panos_ipsec_tunnel_up", "legendFormat": "{{firewall}}: {{tunnel}} [{{role}}]", "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] }
    },
    {
      "id": 10, "type": "bargauge", "title": "Лицензии PAN-OS: дней до истечения",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "(panos_license_expiry_timestamp_seconds - time()) / 86400", "legendFormat": "{{firewall}}: {{feature}}", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "d", "min": 0, "max": 400, "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 60 }, { "color": "green", "value": 120 } ] } }, "overrides": [] }
    },
    {
      "id": 11, "type": "timeseries", "title": "PAN-OS: занятость таблицы сессий, %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "100 * panos_sessions_active / panos_sessions_max", "legendFormat": "{{firewall}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 80 } ] } }, "overrides": [] }
    },
    {
      "id": 12, "type": "timeseries", "title": "Blackbox: длительность проб",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "probe_duration_seconds", "legendFormat": "{{probe_target}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 13, "type": "timeseries", "title": "Скрейпы по джобам (up)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "sum by (job) (up)", "legendFormat": "{{job}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    }
  ]
}
