      artifacts: true
      optional: true
    - job: "Deploy users for clickhouse"

Deploy review data-platform-airbyte:
  extends:
    - .trigger
  stage: review
  trigger:
    project: shop-app/bi/data-platform/airbyte
  only:
    variables:
      - $REVIEW_DATAPLATFORM_ELT_BRANCH

Deploy review data-platform-dagster:
  extends:
    - .trigger
  stage: review
  trigger:
    project: shop-app/bi/data-platform/dagster
  only:
    variables:
      - $REVIEW_DATAPLATFORM_ELT_BRANCH

Reimport dev dump to DB:
  stage: reimport
  extends:
    - .review_werf
  variables:
    DELETE_FILE: /tmp/delete-database-$CI_PIPELINE_ID.yaml
    IMPORT_FILE: /tmp/import-database-$CI_PIPELINE_ID.yaml
  resource_group: mssql
  script:
    - set -x
    - |
      DELETE_RENDER=$(werf render | yq 'select(.metadata.name == "*delete-database" or .metadata.name == "*-job-scripts")')
      echo "$DELETE_RENDER" | yq -N '(.kind, .metadata.name)' \
      | xargs -rn2 werf kubectl delete -n ${WERF_NAMESPACE} || true
    - |
      echo "$DELETE_RENDER" | werf kubectl apply --namespace=${WERF_NAMESPACE} -f -
    - |
      echo "$DELETE_RENDER" | yq -N 'select(.kind == "Job") | .metadata.name' \
      | xargs -r werf kubectl wait --namespace=${WERF_NAMESPACE} --for=condition=complete --timeout=600s job
    - |
      IMPORT_RENDER=$(werf render | yq 'select(.metadata.name == "*import-dump")')
      echo "$IMPORT_RENDER" | yq -N '(.kind, .metadata.name)' \
      | xargs -rn2 werf kubectl delete -n ${WERF_NAMESPACE} || true
    - |
      echo "$IMPORT_RENDER" | werf kubectl apply --namespace=${WERF_NAMESPACE} -f -
    - |
      echo "$IMPORT_RENDER" | yq -N 'select(.kind == "Job") | .metadata.name' \
      | xargs -r werf kubectl wait --namespace=${WERF_NAMESPACE} --for=condition=complete --timeout=600s job
  when: manual
  only:
    variables:
      - $REVIEW_MSSQL
      - ( $WERF_NAMESPACE =~ /^feature-.*/ || $WERF_EXISTED_NAMESPACE =~ /^feature-.*/ || $WERF_NEW_NAMESPACE =~ /^feature-.*/ || $CI_COMMIT_REF_SLUG =~ /^feature-.*/ ) && $MSSQL
  needs:
    - job: "Prepare review vars"
      artifacts: true
      optional: true
  tags:
    - docker

Import dev dump to clickhouse:
  stage: review
  extends:
    - .review_werf
  variables:
    IMPORT_FILE: /tmp/import-clickhouse-database-$CI_PIPELINE_ID.yaml
  script:
    - |
      werf render | yq 'select(.metadata.name == "*import-clickhouse-dump")' | tee ${IMPORT_FILE}

    - |
      yq -N '(.kind, .metadata.name)' ${IMPORT_FILE} \
      | xargs -rn2 werf kubectl delete -n ${WERF_NAMESPACE} || true

    - |
      werf kubectl apply --namespace=${WERF_NAMESPACE} -f ${IMPORT_FILE}

    - |
      werf kubectl wait --namespace=${WERF_NAMESPACE} --for=condition=complete --timeout=600s \
      job $(yq -N 'select(.kind == "Job") | .metadata.name' ${IMPORT_FILE})

    - rm ${IMPORT_FILE}
  when: manual
  needs:
    - job: "Prepare review vars"
      artifacts: true
      optional: true
    - job: Prepare review namespace
    - job: Deploy clickhouse
  only:
    variables:
      - $REVIEW_CLICKHOUSE
  except:
    variables:
      - $CI_PROJECT_PATH == "shop-app/review"
      - $CI_PIPELINE_SOURCE == "pipeline"
  tags:
    - docker

Deploy code:
  stage: review
  resource_group: ${WERF_NAMESPACE}
  extends:
    - .review_werf
    - .needs_infra
  except:
    variables:
      - $CI_PROJECT_PATH == "shop-app/review"
      - $CI_PIPELINE_SOURCE == "pipeline"

.triggered_deploy_needs:
  needs:
    - job: "Build"
      optional: true
    - job: "Build web-ui"
      optional: true
    - job: "Lint web-ui"
      optional: true
    - job: "Upload static to S3 for Triggered deploy code DEV"
      optional: true

Triggered deploy code:
  extends:
    - Deploy code
  stage: multideploy
  needs: !reference [.triggered_deploy_needs, needs]
  only:
    variables:
      - >
        $CI_PIPELINE_SOURCE == "pipeline"
        && ( $WERF_NAMESPACE =~ /^feature-.*/ || $WERF_EXISTED_NAMESPACE =~ /^feature-.*/ || $WERF_NEW_NAMESPACE =~ /^feature-.*/ || $MULTIDEPLOY == "true")
        && $WERF_ENV
  except:
    variables:
      - $CI_PROJECT_PATH == "shop-app/review"
      - $CI_PIPELINE_SOURCE == "pipeline" && $MULTIDEPLOY == "true" && $CONTEXT_WERF == "production-reserve"
  when: on_success
  retry:
    max: 1
    when:
      - runner_system_failure
      - stuck_or_timeout_failure
      - api_failure
      - data_integrity_failure
    exit_codes:
      - 1
      - 137

Triggered deploy to Production reserve-b:
  extends:
    - Triggered deploy code
    - .include_replicas
  stage: production-reserve
  needs:
    - !reference [.triggered_deploy_needs, needs]
    - job: Triggered deploy code
      optional: true
  variables:
    WERF_KUBE_CONTEXT: $CONTEXT_PRODUCTION_RESERVE
    WERF_SET_CLUSTER_INFO: global.cluster_type=reserve
  only:
    variables:
      - >
        $CI_PIPELINE_SOURCE == "pipeline"
        && $MULTIDEPLOY == "true"
        && $WERF_ENV == "production"
  except:
    variables:
      - $CI_PROJECT_PATH == "shop-app/review"
      - $CI_PIPELINE_SOURCE == "pipeline" && $MULTIDEPLOY == "true" && $CONTEXT_WERF == "production-reserve"

Triggered deploy to tenant-a reserve:
  extends:
    - Triggered deploy code
    - .include_tenant_a_replicas
  stage: tenant-a-reserve
  needs:
    - !reference [.triggered_deploy_needs, needs]
    - job: Triggered deploy code
      optional: true
  variables:
    WERF_KUBE_CONTEXT: $CONTEXT_TENANT_A_RESERVE
  after_script: []
  only:
    variables:
      - >
        $CI_PIPELINE_SOURCE == "pipeline"
        && $MULTIDEPLOY == "true"
        && $WERF_ENV == "tenant-a"
  except:
    variables:
      - $DEPLOY_TO_RESERVE_TENANT_A_CLUSTER == "false"
      - $CI_PROJECT_PATH == "shop-app/review"
      - $CI_PIPELINE_SOURCE == "pipeline" && $MULTIDEPLOY == "true" && $CONTEXT_WERF == "production-reserve"

