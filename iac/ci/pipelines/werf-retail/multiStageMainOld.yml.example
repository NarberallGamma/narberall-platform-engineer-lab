include:
  - local: '/multiStageMainCommon.yml.example'

# manual deploy to production
Deploy to Production:
  extends: .deploy
  stage: production
  environment:
    name: production
  variables:
    KUBE_NAMESPACE: production
    WERF_KUBE_CONTEXT: ${CONTEXT_PRODUCTION_MAIN}
    WERF_SET_CLUSTER_INFO: global.cluster_type=production
    WERF_SET_CLUSTER_CONTEXT: global.cluster_context=${CONTEXT_PRODUCTION_MAIN}
    WERF_SET_NEW_RELIC_ENABLED: envs.NEW_RELIC_ENABLED=false
  only:
    - master
    - production
    - /^sales.*$/
    - /^release.*$/
  except:
    - schedules
    - triggers
    - pipelines
  when: manual

.deploy-production-reserve:
  extends: .deploy
  stage: production-reserve
  environment:
    name: production
  variables:
    KUBE_NAMESPACE: production
    WERF_KUBE_CONTEXT: ${CONTEXT_PRODUCTION_RESERVE}
    WERF_SET_CLUSTER_INFO: global.cluster_type=reserve
    WERF_SET_CLUSTER_CONTEXT: global.cluster_context=${CONTEXT_PRODUCTION_RESERVE}
  only:
    - master
    - production
    - /^sales.*$/
    - /^release.*$/
  except:
    - schedules
    - triggers
    - pipelines
  when: manual

# auto deploy to production-reserve
Deploy to Production-reserve:
  extends:
    - .deploy-production-reserve
    - .include_replicas
  dependencies:
    - Deploy to Production
  needs:
    - Deploy to Production
  variables:
    WERF_SET_CLUSTER_INFO: global.cluster_type=reserve
  only:
    variables:
      - $DEPLOY_TO_RESERVE_CLUSTER == "true"
    refs:
      - master
      - production
      - /^sales.*$/
      - /^release.*$/
  when: on_success

# auto deploy to demo
Deploy to Demo (auto):
  extends: .deploy
  stage: production-reserve
  dependencies:
    - Deploy to Production
  needs:
    - job: Deploy to Production
      artifacts: false
  environment:
    name: demo
  variables:
    KUBE_NAMESPACE: demo
    WERF_KUBE_CONTEXT: dev
    WERF_SET_NEW_RELIC_ENABLED: envs.NEW_RELIC_ENABLED=false
    WERF_SET_CLUSTER_CONTEXT: global.cluster_context=${WERF_KUBE_CONTEXT}
  only:
    - master
    - production
    - /^sales.*$/
    - /^release.*$/
  except:
    - schedules
    - triggers
    - pipelines
  when: on_success

# auto deploy to sales
Deploy to Sales (auto):
  extends: .deploy
  stage: production-reserve
  dependencies:
    - Deploy to Production
  needs:
    - job: Deploy to Production
      artifacts: false
  environment:
    name: sales
  variables:
    KUBE_NAMESPACE: sales
    WERF_KUBE_CONTEXT: dev
    WERF_SET_NEW_RELIC_ENABLED: envs.NEW_RELIC_ENABLED=false
    WERF_SET_CLUSTER_CONTEXT: global.cluster_context=${WERF_KUBE_CONTEXT}
  only:
    - master
    - production
    - /^sales.*$/
    - /^release.*$/
  except:
    - schedules
    - triggers
    - pipelines
  when: on_success

# auto deploy ingresses
# candidate for removal in favor of Auto Deploy to Production-reserve
Deploy Ingresses to Production-reserve:
  extends:
    - .deploy-production-reserve
  dependencies:
    - Deploy to Production
  needs:
    - Deploy to Production
  variables:
    WERF_SET_CLUSTER_INFO: global.cluster_type=reserve
  only:
    variables:
      - $CI_PROJECT_NAME == "ingresses"
    refs:
      - master
      - production
      - /^sales.*$/
      - /^release.*$/
  when: on_success

# manual deploy to production-reserve
Deploy to Production-reserve-manual:
  extends:
    - .deploy-production-reserve
  variables:
    WERF_SET_CLUSTER_INFO: global.cluster_type=reserve-manual
  only:
    variables:
      - $MANUAL_RESERVE_CLUSTER == "manual"
    refs:
      - master
      - production
      - /^sales.*$/
      - /^release.*$/
      - /^infra-ops.*$/
  when: manual

Deploy to Production-reserve-manual-with-reserve-replicas:
  extends:
    - .deploy-production-reserve
    - .include_replicas
  variables:
    WERF_SET_CLUSTER_INFO: global.cluster_type=reserve-manual
  only:
    variables:
      - $MANUAL_RESERVE_CLUSTER == "manual"
    refs:
      - master
      - production
      - /^sales.*$/
      - /^release.*$/
      - /^infra-ops.*$/
  when: manual

Deploy to tenant-a:
  extends: .deploy
  stage: tenant-a
  variables:
    KUBE_NAMESPACE: tenant-a
    WERF_KUBE_CONTEXT: ${CONTEXT_TENANT_A_MAIN}
    WERF_SET_NEW_RELIC_ENABLED: envs.NEW_RELIC_ENABLED=false
    WERF_SET_CLUSTER_CONTEXT: global.cluster_context=${WERF_KUBE_CONTEXT}
  environment:
    name: tenant-a
  #allow_failure: false
  only:
    - master
    - production
    - /^sales.*$/
    - /^release.*$/
  except:
    - schedules
    - triggers
    - pipelines
  when: manual

Deploy to tenant-a Reserve:
  extends:
    - .deploy
    - .include_tenant_a_replicas
  stage: tenant-a-reserve
  variables:
    KUBE_NAMESPACE: tenant-a
    WERF_KUBE_CONTEXT: ${CONTEXT_TENANT_A_RESERVE}
    WERF_SET_NEW_RELIC_ENABLED: envs.NEW_RELIC_ENABLED=false
    WERF_SET_CLUSTER_INFO: global.cluster_type=reserve
    WERF_SET_CLUSTER_CONTEXT: global.cluster_context=${WERF_KUBE_CONTEXT}
  environment:
    name: tenant-a
  #allow_failure: false
  dependencies:
    - Deploy to tenant-a
  needs:
    - Deploy to tenant-a
  only:
    variables:
      - $DEPLOY_TO_RESERVE_CLUSTER == "true"
    refs:
      - master
      - production
      - /^sales.*$/
      - /^release.*$/
  except:
    - schedules
    - triggers
    - pipelines
  when: on_success

