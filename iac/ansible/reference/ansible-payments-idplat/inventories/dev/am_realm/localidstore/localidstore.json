//локал стор + модули авторизации которые добавлены во флоу + настроойка каналов доставки
{
    //Конфигурация плагинов
    "Plugins": 
	{
        //Модули аутентификации
        "IAuthenticationModule": [
            //DataStoreLoginModule
            {
                "Name": "DataStoreLoginModule_Static",
                "PluginName": "DataStoreLoginModule",
                "Configuration": {
                    "AllowUserJwtAssertion": true
                }
            },
            //OathModule
            {
                "Name": "OathModule_Static",
                "PluginName": "OathModule",
                "Configuration": {
                    "ForceTwoFactorAuth": true,
                    "ApplicationName": "Static application",
                    "SkipAuthMethods": [
                        "static_method1",
                        "static_method2"
                    ]
                }
            },
            //OneTimePasswordModule
            {
                "Name": "OneTimePasswordModule_Static",
                "PluginName": "OneTimePasswordModule",
                "Configuration": 
				{
                    "MessageContent": "Static content",
                    "MessageSubject": "Static subject",
                    "EnableSmsChannel": true,
                    "EnableSmtpChannel": true
                }
            }
        ],
        // Каналы доставки
        "IMessagingChannel": [
            //FileMessagingChannel
            {
                "Name": "FileMessagingChannel_Static",
                "PluginName": "FileMessagingChannel",
                "Configuration": {
                    "FilePath": ".\\Path_to_file\\Static",
                    "MessagingServices": [
                        "Static1",
                        "Static2",
                        "email"
                    ]
                }
            },
            //SmtpMessagingChannel
            {
                "Name": "SmtpMessagingChannel_Static",
                "PluginName": "SmtpMessagingChannel",
                "Configuration": {
                    "Host": "smtp.example.com",
                    "Port": 25,
                    "From": "mail@example.com",
                    "User": "test",
                    "Password": "CHANGE_ME"
                }
            },
            //SmppMessagingChannel
            {
                "Name": "SmppMessagingChannel_Static",
                "PluginName": "SmppMessagingChannel",
                "Configuration": {
                    "Server": "1.1.1.1",
                    "Port": 23,
                    "ServiceType": "servicetype_statyc",
                    "SenderName": "SerderName_static",
                    "SystemId": "systemID_static",
                    "Password": "CHANGE_ME",
                    "DataEncoding": 1,
                    "SubmitDataEncoding": 1,
                    "MessageDataEncoding": 1,
                    "SourceTon": 1,
                    "SourceNpi": 1,
                    "MultiConnection": false,
                    "RecoveryConnectionTimeout": 10000,
                    "AttemptToConnectInterval": 5000,
                    "PhoneKeyName": "msisdnnumber"
                }
            },
            //NatsMessagingChannel
            {
                "Name": "NatsMessagingChannel_Static",
                "PluginName": "NatsMessagingChannel",
                "Configuration": {
                    "MessagingServices": [
                        "sms",
                        "email"
                    ],
                    "NatsServices": [
                        "1.1.1.1:11111"
                    ],
                    "CredFile": ""
                }
            }
        ]
    },
    //Конфигурация потоков аутентификации
    "AuthFlows": 
		{
			"Default": 
			{
				"Steps": 
				[
					{
						"ModuleName": "DataStoreLoginModule_Static"
					},
					{
						"ModuleName": "OathModule_Static"
					},
					{
						"ModuleName": "OneTimePasswordModule_Static"
					}
				]
			}
		}
}