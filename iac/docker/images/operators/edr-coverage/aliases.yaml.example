# Manual mappings "host -> EDR agent name".
#
# Needed where the link exists but the data does not show it. The main case is
# domain-joined Macs: the agent registers under a local name
# ('MacBook-Air-admin.local'), and if the network name looks like an IP,
# macOS cuts it at the first dot and EDR gets '192'. The domain name is not in
# any API field, so no key can join them.
#
# merge3 does NOT auto-match such pairs by username: a second laptop of the
# same person would silently break the metric. Instead it writes candidates
# to the log — the line "aliases.yaml candidates (user matched…)".
# Check them in the EDR console and copy them here.
#
# Agent name is the value in the name column of {company}_edr.csv (case and
# underscores do not matter). If no agent with that name is in the export,
# merge3 warns: the agent was likely reinstalled and the entry is stale.
#
# For truncated names, point at displayname, not name: three different Macs
# share the name '192', and merge3 tells them apart by displayname
# (192.168.1.11 / .15 / .8) — so the mapping points at a specific machine.

companies:
  project-e:
    m-user-a: MAC             # Mac.loc, lastuser a.user
    m-user-b: 192.168.1.15    # shown this way in the console; name truncated to '192'

  project-c:
    m-proj-c-00020: M-PROJ-C-00020-1
