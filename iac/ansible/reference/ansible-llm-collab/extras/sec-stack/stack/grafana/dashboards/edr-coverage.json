{
  "uid": "edr-coverage",
  "title": "EDR coverage",
  "tags": [
    "sec-stack",
    "edr"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "company",
        "label": "Company",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(edr_hosts_total, company)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "EDR coverage",
      "description": "Share of hosts in the pool that have an agent. Computed from counters, not taken as a ready-made percentage — so it aggregates correctly over any set of companies.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "100 * sum(edr_hosts_with_agent{company=~\"$company\"}) / sum(edr_hosts_total{company=~\"$company\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Agent online",
      "description": "Share of hosts whose agent is not only installed but online.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "100 * sum(edr_hosts_agent_online{company=~\"$company\"}) / sum(edr_hosts_total{company=~\"$company\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Hosts without agent",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "sum(edr_hosts_total{company=~\"$company\"}) - sum(edr_hosts_with_agent{company=~\"$company\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total hosts in pool",
      "description": "Coverage denominator. Excluded: hosts dropped by exclusions.yaml rules and managed nodes marked by the cloud.",
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 14,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "sum(edr_hosts_total{company=~\"$company\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Data freshness",
      "description": "Left — when coverage was last computed; right — age of the oldest EDR export. While the export is dropped in by hand, the second number matters more.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "time() - edr_collection_timestamp_seconds",
          "legendFormat": "calculation",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "time() - min(edr_source_data_timestamp_seconds{source=\"edr\"})",
          "legendFormat": "EDR export",
          "instant": true,
          "refId": "B"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 172800
              },
              {
                "color": "red",
                "value": 1209600
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Coverage trend by company",
      "description": "This is the point of the dashboard: whether coverage is growing or stuck.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "100 * sum by (company) (edr_hosts_with_agent{company=~\"$company\"}) / sum by (company) (edr_hosts_total{company=~\"$company\"})",
          "legendFormat": "{{company}}",
          "refId": "A"
        },
        {
          "expr": "100 * sum(edr_hosts_with_agent{company=~\"$company\"}) / sum(edr_hosts_total{company=~\"$company\"})",
          "legendFormat": "total",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Coverage by company — click drills into the company",
      "description": "A click on a bar opens this same dashboard filtered to the selected company: tables below show its machines.",
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "100 * sum by (company) (edr_hosts_with_agent) / sum by (company) (edr_hosts_total)",
          "legendFormat": "{{company}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "links": [
            {
              "title": "Show hosts of company ${__field.labels.company}",
              "url": "/d/edr-coverage/edr-coverage?var-company=${__field.labels.company}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Coverage: servers vs workstations",
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "100 * sum by (host_type) (edr_hosts_with_agent{company=~\"$company\"}) / sum by (host_type) (edr_hosts_total{company=~\"$company\"})",
          "legendFormat": "{{host_type}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Hosts without an EDR agent — these still need rollout",
      "description": "Filtered by the Company variable at the top and by a click on the bar above.",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "edr_host_agent_installed{company=~\"$company\"} == 0",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "company": "Company",
              "hostname": "Host",
              "host_type": "Type"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Company"
              },
              {
                "field": "Host"
              }
            ]
          }
        }
      ],
      "options": {
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "fields": [
            "Host"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Agent present but silent — investigate, do not reinstall",
      "description": "Agent was found but is offline according to EDR: the machine is off, the agent is broken, or it was decommissioned.",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "edr_host_agent_online{company=~\"$company\"} == 0 and edr_host_agent_installed{company=~\"$company\"} == 1",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "company": "Company",
              "hostname": "Host",
              "host_type": "Type"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Company"
              },
              {
                "field": "Host"
              }
            ]
          }
        }
      ],
      "options": {
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "fields": [
            "Host"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Company summary",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "sum by (company) (edr_hosts_total{company=~\"$company\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (company) (edr_hosts_with_agent{company=~\"$company\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sum by (company) (edr_hosts_agent_online{company=~\"$company\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "sum by (company) (edr_hosts_total{company=~\"$company\"}) - sum by (company) (edr_hosts_with_agent{company=~\"$company\"})",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "100 * sum by (company) (edr_hosts_with_agent{company=~\"$company\"}) / sum by (company) (edr_hosts_total{company=~\"$company\"})",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "expr": "sum by (company) (edr_hosts_managed{company=~\"$company\"})",
          "format": "table",
          "instant": true,
          "refId": "F"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "company",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true
            },
            "renameByName": {
              "company": "Company",
              "Value #A": "Total",
              "Value #B": "With agent",
              "Value #C": "Online",
              "Value #D": "Without agent",
              "Value #E": "Coverage, %",
              "Value #F": "Managed"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Coverage, %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 70
                    },
                    {
                      "color": "yellow",
                      "value": 85
                    },
                    {
                      "color": "green",
                      "value": 95
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Without agent"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Managed (agent not possible)",
      "description": "Managed-service nodes (DB, kubernetes): the cloud marks them in its API; an agent cannot be installed there. They are not in coverage — neither numerator nor denominator. Shown separately so the exclusion is visible, not silent.",
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 17,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "sum(edr_hosts_managed{company=~\"$company\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Agents without a host in inventory — missing-source signal",
      "description": "When an inventory source drops entirely, coverage stays pretty: the percentage is computed over hosts that are still visible. That is only visible from here — agents with no matching host. The value is TENANT-SCOPED: companies in a shared tenant (project-b, project-a, project-c, project-e, and others) share one agent list, so their lines coincide — that is one number, not several. Do not sum by company. Steady baseline (known gaps in the shared tenant and in project-d): cloud B VDI pool, project-f tenant in cloud A, office segment, uncollectable on-prem. Watch for jumps.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "edr_agents_without_inventory{company=~\"$company\"}",
          "legendFormat": "{{company}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "noValue": "0",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "drawStyle": "line"
          }
        },
        "overrides": []
      }
    }
  ]
}
