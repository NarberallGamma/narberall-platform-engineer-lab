# Манифест скачанной модели (шаблон Ansible, роль llm_dev_model_fetch)
generated_at: "{{ ansible_facts['date_time'].iso8601 | default('', true) }}"
preset: "{{ llm_dev_model_preset | default('') }}"
description: "{{ llm_dev_model_fetch_resolved_description | default('') }}"
download_url: "{{ llm_dev_model_download_url }}"
download_urls:
{% for f in llm_dev_model_fetch_resolved_hf_files %}
  - "https://huggingface.co/{{ llm_dev_model_fetch_resolved_repo }}/resolve/{{ llm_dev_model_fetch_resolved_revision }}/{{ f }}"
{% endfor %}
hf_files:
{% for f in llm_dev_model_fetch_resolved_hf_files %}
  - "{{ f }}"
{% endfor %}
local_path: "{{ llm_dev_models_dir }}/{{ llm_dev_model_filename }}"
inventory_hostname: "{{ inventory_hostname }}"
requires_hf_token: {{ llm_dev_model_fetch_requires_hf_token | bool }}
