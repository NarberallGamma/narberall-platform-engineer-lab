{
  "uid": "edr-coverage",
  "title": "EDR coverage",
  "tags": [
    "sec-stack",
    "edr"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "company",
        "label": "Компания",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(edr_hosts_total, company)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Покрытие EDR",
      "description": "Доля хостов в пуле, на которых найден агент. Считается из счётчиков, а не берётся готовым процентом — поэтому корректно агрегируется по любому набору компаний.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "100 * sum(edr_hosts_with_agent{company=~\"$company\"}) / sum(edr_hosts_total{company=~\"$company\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Агент на связи",
      "description": "Доля хостов, у которых агент не просто установлен, а онлайн.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "100 * sum(edr_hosts_agent_online{company=~\"$company\"}) / sum(edr_hosts_total{company=~\"$company\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Хостов без агента",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "sum(edr_hosts_total{company=~\"$company\"}) - sum(edr_hosts_with_agent{company=~\"$company\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Всего хостов в пуле",
      "description": "Знаменатель покрытия. Не входят: исключённые правилами exclusions.yaml и managed-ноды, помеченные облаком.",
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 14,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "sum(edr_hosts_total{company=~\"$company\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Свежесть данных",
      "description": "Слева — когда последний раз считалось покрытие, справа — возраст самой старой выгрузки из EDR. Пока выгрузка кладётся руками, второе число важнее первого.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "time() - edr_collection_timestamp_seconds",
          "legendFormat": "расчёт",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "time() - min(edr_source_data_timestamp_seconds{source=\"edr\"})",
          "legendFormat": "выгрузка EDR",
          "instant": true,
          "refId": "B"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 172800
              },
              {
                "color": "red",
                "value": 1209600
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Динамика покрытия по компаниям",
      "description": "Ради этого всё и затевалось: видно, растёт покрытие или стоит.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "100 * sum by (company) (edr_hosts_with_agent{company=~\"$company\"}) / sum by (company) (edr_hosts_total{company=~\"$company\"})",
          "legendFormat": "{{company}}",
          "refId": "A"
        },
        {
          "expr": "100 * sum(edr_hosts_with_agent{company=~\"$company\"}) / sum(edr_hosts_total{company=~\"$company\"})",
          "legendFormat": "всего",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "всего"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Покрытие по компаниям — клик проваливается в компанию",
      "description": "Клик по столбцу открывает этот же дашборд, отфильтрованный на выбранную компанию: таблицы ниже покажут её конкретные машины.",
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "100 * sum by (company) (edr_hosts_with_agent) / sum by (company) (edr_hosts_total)",
          "legendFormat": "{{company}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "links": [
            {
              "title": "Показать хосты компании ${__field.labels.company}",
              "url": "/d/edr-coverage/edr-coverage?var-company=${__field.labels.company}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Покрытие: серверы против АРМ",
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "100 * sum by (host_type) (edr_hosts_with_agent{company=~\"$company\"}) / sum by (host_type) (edr_hosts_total{company=~\"$company\"})",
          "legendFormat": "{{host_type}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Хосты без агента EDR — на них надо донести",
      "description": "Фильтруется переменной «Компания» вверху и кликом по столбцу выше.",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "edr_host_agent_installed{company=~\"$company\"} == 0",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "company": "Компания",
              "hostname": "Хост",
              "host_type": "Тип"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Компания"
              },
              {
                "field": "Хост"
              }
            ]
          }
        }
      ],
      "options": {
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "fields": [
            "Хост"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Агент есть, но молчит — разбираться, а не переустанавливать",
      "description": "Агент найден, но по данным EDR не на связи: машина выключена, агент сломан или её вывели из эксплуатации.",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "edr_host_agent_online{company=~\"$company\"} == 0 and edr_host_agent_installed{company=~\"$company\"} == 1",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "company": "Компания",
              "hostname": "Хост",
              "host_type": "Тип"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Компания"
              },
              {
                "field": "Хост"
              }
            ]
          }
        }
      ],
      "options": {
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "fields": [
            "Хост"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Сводка по компаниям",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "sum by (company) (edr_hosts_total{company=~\"$company\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (company) (edr_hosts_with_agent{company=~\"$company\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sum by (company) (edr_hosts_agent_online{company=~\"$company\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "sum by (company) (edr_hosts_total{company=~\"$company\"}) - sum by (company) (edr_hosts_with_agent{company=~\"$company\"})",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "100 * sum by (company) (edr_hosts_with_agent{company=~\"$company\"}) / sum by (company) (edr_hosts_total{company=~\"$company\"})",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "expr": "sum by (company) (edr_hosts_managed{company=~\"$company\"})",
          "format": "table",
          "instant": true,
          "refId": "F"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "company",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true
            },
            "renameByName": {
              "company": "Компания",
              "Value #A": "Всего",
              "Value #B": "С агентом",
              "Value #C": "На связи",
              "Value #D": "Без агента",
              "Value #E": "Покрытие, %",
              "Value #F": "Managed"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Покрытие, %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 70
                    },
                    {
                      "color": "yellow",
                      "value": 85
                    },
                    {
                      "color": "green",
                      "value": 95
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Без агента"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Managed (агент невозможен)",
      "description": "Ноды managed-сервисов (БД, kubernetes): облако помечает их в своём API, агент туда поставить нельзя. В покрытие не входят — ни в числитель, ни в знаменатель. Показаны отдельно, чтобы исключение было видимым, а не тихим.",
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 17,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "sum(edr_hosts_managed{company=~\"$company\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Агенты без хоста в инвентаре — сигнал о пропавшем источнике",
      "description": "Когда источник инвентаря отваливается целиком, покрытие остаётся красивым: процент считается по тем хостам, которые ещё видно. Заметно это только отсюда — по агентам, которым не нашлось хоста. Значение ТЕНАНТНОЕ: компании общего тенанта (project-b, project-a, project-c, project-e и др.) делят один список агентов, поэтому их линии совпадают — это одно число, а не несколько. Складывать по компаниям нельзя. Постоянный уровень (известные дыры в общем тенанте и в project-d): VDI-пул облака B, тенант project-f в облаке A, офисный сегмент, несобираемый on-prem. Смотреть надо на скачки.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "edr_agents_without_inventory{company=~\"$company\"}",
          "legendFormat": "{{company}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "noValue": "0",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "drawStyle": "line"
          }
        },
        "overrides": []
      }
    }
  ]
}
