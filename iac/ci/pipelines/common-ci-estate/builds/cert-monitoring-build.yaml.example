# Build the cert-monitoring image and push it to the container registry.
# Include directly: project: 'estate/common-ci', file: '/builds/cert-monitoring-build.yaml.example'
workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "web"

default:
  tags:
    - k8s-kaniko
  timeout: 8h
  interruptible: true

stages:
  - build

variables:
  CERT_MONITORING_IMAGE_NAME: "cert-monitoring"
  CERT_MONITORING_IMAGE_TAG: "2.0"

build-cert-monitoring:
  stage: build
  image:
    name: gcr.io/kaniko-project/executor:debug
    entrypoint: [""]
  script:
    - mkdir -p /kaniko/.docker
    - echo "{\"auths\":{\"$CI_REGISTRY\":{\"auth\":\"$(printf "%s:%s" "$CI_REGISTRY_USER" "$CI_REGISTRY_PASSWORD" | base64 | tr -d '\n')\"}}}" > /kaniko/.docker/config.json
    - |
      if [ -d "$CI_PROJECT_DIR/base-images/cert-monitoring" ]; then
        CONTEXT="$CI_PROJECT_DIR/base-images/cert-monitoring"
      elif [ -d "$CI_PROJECT_DIR/cert-monitoring" ]; then
        CONTEXT="$CI_PROJECT_DIR/cert-monitoring"
      else
        echo "Error: cert-monitoring directory not found"
        exit 1
      fi
    - /kaniko/executor --context "$CONTEXT" --dockerfile "$CONTEXT/Dockerfile" --destination $CI_REGISTRY_IMAGE/$CERT_MONITORING_IMAGE_NAME:$CERT_MONITORING_IMAGE_TAG --custom-platform=linux/amd64
    - echo "Cert monitoring image built and pushed successfully!"
  rules:
    - when: manual
