include:
  - local: '/defaults.yaml.example'

# Consumer repo (estate-global-config) must declare stages in the root .gitlab-ci.yml.

stages:
  - deploy-global-values
  - verify-global-values
  - rollback-global-values

variables:
  EXTERNAL_SECRET_NAMESPACE: "estate"

default:
  tags:
    - docker
  timeout: 8h
  interruptible: true

.k8s_setup: &k8s_setup
  image: $BASE_IMAGE
  before_script:
    - init.sh

deploy-global-values:
  <<: *k8s_setup
  stage: deploy-global-values
  script:
    - kubectl create namespace $EXTERNAL_SECRET_NAMESPACE --dry-run=client -o yaml | kubectl apply -f -
    - kubectl get clustersecretstores.external-secrets.io vault-cluster-secret-store || (echo "vault-cluster-secret-store not found" && exit 1)
    - chmod +x generate-service-external-secrets.sh
    - ./generate-service-external-secrets.sh
    - for file in *-external-secret.yaml; do kubectl apply -f "$file"; done
    - kubectl wait --for=condition=SecretSynced externalsecret -l app.kubernetes.io/name=global-values -n $EXTERNAL_SECRET_NAMESPACE --timeout=300s
    - kubectl get externalsecret -n $EXTERNAL_SECRET_NAMESPACE | grep global-values
  when: manual
  only:
    - main
    - develop

verify-global-values:
  <<: *k8s_setup
  stage: verify-global-values
  script:
    - kubectl get externalsecret -n $EXTERNAL_SECRET_NAMESPACE | grep global-values
    - kubectl get secrets -n $EXTERNAL_SECRET_NAMESPACE | grep "application-env"
  when: manual
  only:
    - main
    - develop

rollback-global-values:
  <<: *k8s_setup
  stage: rollback-global-values
  script:
    - kubectl delete externalsecret -l app.kubernetes.io/name=global-values -n $EXTERNAL_SECRET_NAMESPACE --ignore-not-found
  when: manual
  only:
    - main
    - develop
