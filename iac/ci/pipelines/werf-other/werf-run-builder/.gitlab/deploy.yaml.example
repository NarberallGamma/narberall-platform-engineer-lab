include:
  - local: .gitlab/common.yaml.example

.base_deploy:
  stage: deploy
  script:
    - werf converge
      --skip-build
      --namespace ${CUSTOM_K8S_NAMESPACE:-${K8S_NAMESPACE}}
      --env ${CI_ENVIRONMENT_CUSTOM_SLUG:-${CI_ENVIRONMENT_SLUG}}
  tags:
    - docker

Deploy to cluster-a Dev:
  extends: .base_deploy
  environment:
    name: dev
  variables:
    K8S_NAMESPACE: dev
    WERF_KUBE_CONTEXT: cluster-a
  rules:
    - !reference [.rules, no_schedule]
    - !reference [.rules, no_pipeline]
    - !reference [.rules, master_branch]
  needs:
    - Build development from master
  when: manual

Deploy to cluster-a Dev from develop:
  extends: .base_deploy
  environment:
    name: dev
  variables:
    K8S_NAMESPACE: dev
    WERF_KUBE_CONTEXT: cluster-a
  rules:
    - !reference [.rules, no_schedule]
    - !reference [.rules, no_pipeline]
    - !reference [.rules, develop_branch]
  needs:
    - Build development

Deploy to cluster-a Stage:
  extends: .base_deploy
  environment:
    name: stage
  variables:
    K8S_NAMESPACE: stage
    WERF_KUBE_CONTEXT: cluster-a
  rules:
    - !reference [.rules, no_schedule]
    - !reference [.rules, no_pipeline]
    - !reference [.rules, stage_branch]
  needs:
    - Build stage

Deploy to cluster-a Production:
  extends: .base_deploy
  environment:
    name: production
  variables:
    K8S_NAMESPACE: production
    WERF_KUBE_CONTEXT: cluster-a
  rules:
    - !reference [.rules, no_schedule]
    - !reference [.rules, no_pipeline]
    - !reference [.rules, master_branch]
  needs:
    - Build production
  when: manual
