#        && $MULTIDEPLOY == "true"
#        && $WERF_ENV == "tenant-b"
#        && $DEPLOY_TO_PROD_RESERVE_CLUSTER == "true"
#  except:
#    variables:
#      - $CI_PROJECT_PATH == "shop-app/review"
#  allow_failure: true

# Dismiss
Dismiss code:
  stage: destroy
  resource_group: mssql
  extends:
    - .review_werf
  script:
    - |
      werf dismiss || true
  when: manual
  needs:
    - job: "Prepare review vars"
      artifacts: true
      optional: true
  except:
    variables:
      - $CI_PROJECT_PATH == "shop-app/review"

# FIXME: similar to /reviewStep.yml → "Delete Review Namespace (with Release)"
Destroy review namespace:
  stage: destroy
  extends:
    - .review_werf
  variables:
    GIT_STRATEGY: none
  script:
    - set -x
    - |
      werf kubectl delete gateway "eg-${WERF_NAMESPACE}" --namespace="${WERF_NAMESPACE}" --ignore-not-found
      werf kubectl delete envoyproxy "eg-${WERF_NAMESPACE}" --namespace="${WERF_NAMESPACE}" --ignore-not-found
      werf kubectl patch gatewayclasses.gateway.networking.k8s.io "eg-${WERF_NAMESPACE}" --type=merge \
      --patch='{"metadata":{"finalizers":null}}' || true

      werf helm list --namespace=${WERF_NAMESPACE} -a -oyaml | yq '.[].name' \
      | xargs -trn1 werf helm uninstall --wait --namespace=${WERF_NAMESPACE}
    - werf kubectl delete ns ${WERF_NAMESPACE}
  when: manual
  needs:
    - job: "Prepare review vars"
      artifacts: true
      optional: true
    - job: "Dismiss code"
      optional: true
  except:
    variables:
      - $CI_PROJECT_NAME !~ /^server$|web-ui-internal-ci|web-ui-external-ci|^shop|^review$/
