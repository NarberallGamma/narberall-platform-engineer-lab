#!/bin/sh
# acme.sh --reloadcmd: apply the renewed LE IP cert to the 3X-UI panel
set -eu
docker exec {{ xui_container_name }} /app/x-ui cert \
  -webCert /root/cert/ip/fullchain.pem \
  -webCertKey /root/cert/ip/privkey.pem \
  >/dev/null 2>&1 || true
docker restart {{ xui_container_name }} >/dev/null 2>&1 || true
