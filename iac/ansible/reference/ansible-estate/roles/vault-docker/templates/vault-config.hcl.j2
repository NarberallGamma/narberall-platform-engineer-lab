# Vault Configuration for {{ inventory_hostname }}
# Generated by Ansible

ui = {{ vault_ui_enabled | lower }}
disable_mlock = {{ vault_disable_mlock | lower }}

# API listener
listener "tcp" {
  address = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_disable = 1
}

# Raft storage backend
storage "raft" {
  path = "/vault/data"
  node_id = "{{ node_id }}"
  
  # Retry join configuration for cluster formation
  # Only join other nodes if this is not the first node (vault-1)
  {% if node_id != "vault-1" %}
  {% for node in vault_nodes %}
  {% if node.node_id == "vault-1" %}
  retry_join {
    leader_api_addr = "http://{{ node.ip }}:8200"
  }
  {% endif %}
  {% endfor %}
  {% endif %}
}

# Plugin directory
plugin_directory = "/vault/plugins"

# Custom plugins
{% for plugin in vault_plugins %}
plugin "{{ plugin.name }}" {
  path = "{{ plugin.path }}"
}
{% endfor %}

# Logging
log_level = "{{ vault_log_level }}"
log_format = "json"
log_file = "/vault/logs/vault.log"

# Cluster configuration
cluster_name = "{{ vault_cluster_name }}"

# Performance tuning
{% if vault_disable_mlock %}
disable_mlock = true
{% endif %}

# API configuration
api_addr = "http://{{ ansible_host }}:8200"
cluster_addr = "http://{{ ansible_host }}:8201"
