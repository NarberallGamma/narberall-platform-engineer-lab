# manual deploy to new production reserve
Deploy to NEW Production Reserve:
  extends: .deploy
  stage: production-reserve
  environment:
    name: production-reserve
  variables:
    KUBE_NAMESPACE: production
    CI_ENVIRONMENT_CUSTOM_SLUG: production
    WERF_ENV: production
    WERF_KUBE_CONTEXT: $CONTEXT_PRODUCTION_RESERVE_NEW
    WERF_SET_NEW_RELIC_ENABLED: envs.NEW_RELIC_ENABLED=false
    WERF_SET_CLUSTER_CONTEXT: global.cluster_context=${WERF_KUBE_CONTEXT}
    WERF_SET_CLUSTER_INFO: global.cluster_type=reserve
  only:
    variables:
      - $DEPLOY_TO_PROD_RESERVE_CLUSTER == "true"
    refs:
      - master
      - production
      - /^sales.*$/
      - /^release.*$/
      - /^infra-ops.*$/
  except:
    refs:
      - schedules
      - pipelines
  when: manual

Deploy to NEW Production Reserve (with replicas):
  extends:
    - Deploy to NEW Production Reserve
    - .include_replicas

# manual deploy to new tenant-a reserve
Deploy to NEW tenant-a Reserve:
  extends: .deploy
  stage: tenant-a-reserve
  environment:
    name: tenant-a-reserve
  variables:
    KUBE_NAMESPACE: tenant-a
    CI_ENVIRONMENT_CUSTOM_SLUG: tenant-a
    WERF_KUBE_CONTEXT: $CONTEXT_TENANT_A_RESERVE_NEW
    WERF_SET_NEW_RELIC_ENABLED: envs.NEW_RELIC_ENABLED=false
    WERF_SET_CLUSTER_CONTEXT: global.cluster_context=${WERF_KUBE_CONTEXT}
    WERF_SET_CLUSTER_INFO: global.cluster_type=reserve
  after_script: []
  only:
    variables:
      - $DEPLOY_TO_PROD_RESERVE_CLUSTER == "true"
    refs:
      - master
      - production
      - /^sales.*$/
      - /^release.*$/
      - /^infra-ops.*$/
  except:
    refs:
      - schedules
      - pipelines
  when: manual

Deploy to NEW tenant-a Reserve (with replicas):
  extends:
    - Deploy to NEW tenant-a Reserve
    - .include_tenant_a_replicas

