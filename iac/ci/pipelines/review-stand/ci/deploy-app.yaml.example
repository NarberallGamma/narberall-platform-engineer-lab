# Pull an OCI Helm chart and upgrade one service into the review namespace.
# Job name suffix after deploy- is the service key in app.yml.example.

.deploy-template:
  stage: deploy
  image:
    name: mirror.gcr.io/alpine/helm:3.15.3
    entrypoint: [""]
  variables:
    HELM_MAX_HISTORY: 2
    HELM_KUBEAPISERVER: $DEV_HELM_KUBEAPISERVER
    HELM_KUBETOKEN: $DEV_HELM_KUBETOKEN
    HELM_KUBEINSECURE_SKIP_TLS_VERIFY: true
    HELM_NAMESPACE: $CI_COMMIT_REF_SLUG
  needs:
    - job: clone-postgres
      optional: true
    - job: start-app
      optional: true
  tags:
    - docker
  script:
    - |
      SERVICE_NAME="${CI_JOB_NAME#deploy-}"
      HELM_PROJECT_NAME="$SERVICE_NAME"
      HELM_NAME="$SERVICE_NAME"
      IMAGE="example.registry/shop-app/$SERVICE_NAME"

      get_tag() {
        local service="$1"
        grep "^${service}:" "app.yml.example" | head -n1 | awk -F: '{gsub(/^[[:space:]]+|[[:space:]]+$/,"",$2); print $2}'
      }

      IMAGE_TAG=$(get_tag "$SERVICE_NAME")

      if [ -n "$EXTRA_HELM_SET_SCRIPT" ]; then
        eval "$EXTRA_HELM_SET_SCRIPT"
      else
        EXTRA_HELM_SET_PARAMS=""
      fi

      echo "Deploying $HELM_NAME using image $IMAGE with tag $IMAGE_TAG"

      echo -n "$CI_REGISTRY_PASSWORD" | helm registry login example.registry --username "$CI_REGISTRY_USER" --password-stdin
      helm pull "oci://example.registry/shop-app/${HELM_PROJECT_NAME}/helm/${HELM_NAME}" --version "1.0.0-${IMAGE_TAG}"
      tar zxvf "${HELM_NAME}-1.0.0-${IMAGE_TAG}.tgz"
      rm -rf .helm || true
      mv "${HELM_NAME}" .helm

      helm upgrade -i "${HELM_NAME}" .helm -f .helm/values-dev.yaml --set="image.repository=${IMAGE}" --set="image.tag=${IMAGE_TAG}" --set="domain=${HELM_NAME}-${CI_COMMIT_REF_SLUG}.dev.example.com" $EXTRA_HELM_SET_PARAMS --set=replicaCount=1 --wait --set hpa.enabled=false --timeout 15m0s

deploy-keycloak:
  extends: .deploy-template
  variables:
    EXTRA_HELM_SET_SCRIPT: |
      NODEPORT=$((30000 + RANDOM % (32767-30000+1)))
      EXTRA_HELM_SET_PARAMS="--set env.KC_DB_URL=jdbc:postgresql://postgres:5432/test_keycloak?sslmode=disable \
      --set env.KC_DB_USERNAME=CHANGE_ME \
      --set env.KC_DB_PASSWORD=CHANGE_ME \
      --set nodeport=$NODEPORT"

deploy-shop-agent:
  extends: .deploy-template
  variables:
    EXTRA_HELM_SET_SCRIPT: |
      EXTRA_HELM_SET_PARAMS="--set env.PROFILES=auto\,auto-$CI_COMMIT_REF_SLUG --set env.STAND=test"
  needs: ["deploy-config", "deploy-settings"]

deploy-shop-chat:
  extends: .deploy-template
  variables:
    EXTRA_HELM_SET_SCRIPT: |
      EXTRA_HELM_SET_PARAMS="--set env.PROFILES=auto\,auto-$CI_COMMIT_REF_SLUG --set env.STAND=test"
  needs: ["deploy-config"]

deploy-config:
  extends: .deploy-template
  variables:
    EXTRA_HELM_SET_SCRIPT: |
      EXTRA_HELM_SET_PARAMS="--set env.PROFILES=auto\,git\,vault"

deploy-gateway:
  extends: .deploy-template
  variables:
    EXTRA_HELM_SET_SCRIPT: |
      EXTRA_HELM_SET_PARAMS="--set env.PROFILES=auto\,auto-$CI_COMMIT_REF_SLUG --set env.STAND=test --set domain=$CI_COMMIT_REF_SLUG.dev.example.com"
  needs: ["deploy-config"]

deploy-shop-news-front:
  extends: .deploy-template

deploy-shop-front:
  extends: .deploy-template

deploy-shop-app:
  extends: .deploy-template
  variables:
    EXTRA_HELM_SET_SCRIPT: |
      EXTRA_HELM_SET_PARAMS="--set env.PROFILES=auto\,auto-$CI_COMMIT_REF_SLUG  --set env.STAND=test --set env.SUBDOMAIN=$CI_COMMIT_REF_SLUG --set env.AUDIT_KAFKA_TOPIC=audit-auto-$CI_COMMIT_REF_SLUG --set env.AUDIT_INDEX_NAME=audit-auto-${CI_COMMIT_REF_SLUG}-*"
  needs: ["deploy-config", "deploy-shop-mock", "deploy-settings"]

deploy-shop-notify:
  extends: .deploy-template
  variables:
    EXTRA_HELM_SET_SCRIPT: |
      EXTRA_HELM_SET_PARAMS="--set env.PROFILES=auto\,auto-$CI_COMMIT_REF_SLUG --set env.STAND=test"
  needs: ["deploy-config", "deploy-settings"]

deploy-settings:
  extends: .deploy-template
  variables:
    EXTRA_HELM_SET_SCRIPT: |
      EXTRA_HELM_SET_PARAMS="--set env.PROFILES=auto\,auto-$CI_COMMIT_REF_SLUG --set env.STAND=test"
  needs: ["deploy-config"]

deploy-shop-mock:
  extends: .deploy-template
  variables:
    EXTRA_HELM_SET_SCRIPT: |
      EXTRA_HELM_SET_PARAMS="--set env.PROFILES=auto\,auto-$CI_COMMIT_REF_SLUG --set env.STAND=test"
  needs: ["deploy-config"]

deploy-shop-audit-indexer:
  extends: .deploy-template
  variables:
    EXTRA_HELM_SET_SCRIPT: |
      EXTRA_HELM_SET_PARAMS="--set env.KAFKA_TOPICS=audit-auto-$CI_COMMIT_REF_SLUG --set env.ES_INDEX=audit-auto-$CI_COMMIT_REF_SLUG --set kafka.plaintext=true --set env.KAFKA_BROKERS=kafka:9092"
