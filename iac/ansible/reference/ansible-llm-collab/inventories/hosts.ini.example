# Inventory: cloud VMs plus VMware lab group. Copy to hosts.ini (gitignored).
# Default remote user/key: ansible + /ansible/.ssh/ansible_ssh_key (control node / CI).
# Override from a workstation in the run script / ansible-playbook, for example:
#   -e ansible_user=admin --ssh-key /path/to/admin_ssh_key --ssh-agent
#   -e ansible_user=ubuntu --limit redis.example.com,redis-01.example.com ...
#   -e ansible_user=root --limit jsm-dev.example.com ...

[all:vars]
ansible_user=ansible
ansible_ssh_private_key_file=/ansible/.ssh/ansible_ssh_key
ansible_ssh_common_args='-o IdentitiesOnly=yes'

# GitLab (standalone)
[gitlab]
app-06.example.com ansible_host=10.10.1.241

# App servers
[app]
app-02.example.com ansible_host=10.10.1.11
app-03.example.com ansible_host=10.10.1.39
app-05.example.com ansible_host=10.10.1.24

# Nextcloud dev
[nextcloud_dev]
nextcloud-dev.example.com ansible_host=10.10.1.22

# Nextcloud prod: nginx nextcloud.example.com.conf — upstream .8/.10 активные, .20 backup
[nextcloud_prod_cluster]
nextcloud-prod-oc1.example.com ansible_host=10.10.3.8
nextcloud-prod-oc2.example.com ansible_host=10.10.3.10
nextcloud-prod-oc3.example.com ansible_host=10.10.3.20

# Nextcloud Clients Regul (cloud.example.com)
[nextcloud_regul]
app-02.example.com

