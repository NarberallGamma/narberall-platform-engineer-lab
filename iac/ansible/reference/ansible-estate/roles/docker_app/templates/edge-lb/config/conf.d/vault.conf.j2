# Managed by Ansible (docker_app edge-lb)
# Vault TLS proxy — {{ edge_lb_vault_domain }}

upstream vault_backend {
{% if edge_lb_vault_upstream_sidecar_enabled | default(false) %}
    include /etc/nginx/vault_upstream/vault_active_upstream.conf;
{% else %}
{% for node in edge_lb_vault_backends %}
    server {{ node.ip }}:{{ node.port | default(8200) }}
        max_fails={{ edge_lb_vault_health_check_retries | default(3) }}
        fail_timeout={{ edge_lb_vault_health_check_interval | default(10) }}s
        weight=1;
{% endfor %}
{% endif %}
    keepalive 32;
    keepalive_requests 100;
    keepalive_timeout 60s;
}

limit_req_zone $binary_remote_addr zone=vault_limit:10m rate={{ docker_app.rate_limit_zone_rate | default('10r/s') }};

server {
    listen {{ docker_app.listen_port | default(443) }} ssl;
    server_name {{ edge_lb_vault_domain }};
    http2 on;

    ssl_certificate /etc/nginx/certs/{{ edge_lb_cert_basename }}.crt;
    ssl_certificate_key /etc/nginx/certs/{{ edge_lb_cert_basename }}.key;
    ssl_protocols {{ docker_app.ssl_protocols | default('TLSv1.2 TLSv1.3') }};
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;

    limit_req zone=vault_limit burst={{ docker_app.rate_limit_burst | default(20) }} nodelay;

    error_log /var/log/nginx/{{ edge_lb_vault_domain }}/error.log warn;
    access_log /var/log/nginx/{{ edge_lb_vault_domain }}/access.log main;

    location / {
        proxy_pass http://vault_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Vault-Request true;
        proxy_set_header X-Vault-Token $http_x_vault_token;

        proxy_connect_timeout {{ docker_app.proxy_connect_timeout | default('5s') }};
        proxy_send_timeout {{ docker_app.proxy_send_timeout | default('60s') }};
        proxy_read_timeout {{ docker_app.proxy_read_timeout | default('60s') }};

        proxy_next_upstream {{ edge_lb_vault_proxy_next_upstream | default('error timeout invalid_header http_429 http_503 http_500 http_502 http_504') }};
        proxy_next_upstream_tries {{ edge_lb_vault_upstream_tries | default(3) }};

        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }

    location /nginx-health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    location /v1/sys/health {
        proxy_pass http://vault_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
        proxy_next_upstream {{ edge_lb_vault_proxy_next_upstream | default('error timeout invalid_header http_429 http_503 http_500 http_502 http_504') }};
        proxy_next_upstream_tries {{ edge_lb_vault_upstream_tries | default(3) }};
    }
}
