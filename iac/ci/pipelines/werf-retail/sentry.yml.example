  rules:
    - !reference [.rules_not_trigger]
    - !reference [.rules_not_pipeline]
    - !reference [.rules_not_schedule]
    - if: $CI_COMMIT_BRANCH =~ /master$|production$|^sales.*$|^release.*$/ && $WERF_ENV == "tenant-a" && $CI_PROJECT_NAME =~ /^web-ui-.*$/
    - when: never
