# скопировать в .env (в git не коммитить) — при деплое ansible генерит .env сам
# из SOPS-секретов (роль sec_stack).
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# API-ключи PAN-OS: по одному на каждый файрвол из exporters/panos/config.yml.
# Имя переменной = PANOS_API_KEY_ + имя файрвола (upper, '-' -> '_').
PANOS_API_KEY_NGFW01_SITE_A=CHANGE_ME
PANOS_API_KEY_NGFW02_SITE_A=CHANGE_ME
PANOS_API_KEY_NGFW_TEST_SITE_A=CHANGE_ME
PANOS_API_KEY_NGFW_PROJECT_B=CHANGE_ME
PANOS_API_KEY_NGFW_PROJECT_C=CHANGE_ME
PANOS_API_KEY_NGFW01_PROJECT_D=CHANGE_ME
PANOS_API_KEY_NGFW02_PROJECT_D=CHANGE_ME
PANOS_API_KEY_NGFW01_PROJECT_E=CHANGE_ME
