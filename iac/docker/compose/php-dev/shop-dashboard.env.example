APP_NAME=Shop dashboard
APP_ENV=local
APP_KEY=CHANGE_ME
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=shop-dashboard-mysql
DB_PORT=3306
DB_DATABASE=shop_dashboard
DB_USERNAME=shop_dashboard
DB_PASSWORD=CHANGE_ME
DB_PREFIX=""

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SIDECAR_DB_CONNECTION=mysql
SIDECAR_DB_HOST=sidecar-mysql
SIDECAR_DB_DATABASE=billing
SIDECAR_DB_USERNAME=root
SIDECAR_DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
CACHE_STORE=memcached
MEMCACHED_PERSISTENT_ID=shop1
MEMCACHED_HOST=shop-dashboard-memcached
MEMCACHED_HOST2=shop-dashboard-memcached2
MEMCACHED_HOST3=shop-dashboard-memcached3
MEMCACHED_PORT=11211
