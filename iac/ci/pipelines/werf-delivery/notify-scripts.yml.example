.script_notify_slack_deploy_started: |
  echo "THREAD=$THREAD" > thread.env
  curl --request POST \
    --header "Content-Type: application/json" \
    --header "Authorization: Bearer $SLACK_NOTIFICATIONS" \
    "https://slack.com/api/chat.postMessage" \
    --data '{
      "channel": "'$SLACK_CHANNEL'",
      "thread_ts": "'$THREAD'",
      "text": "`'"$CI_PROJECT_NAMESPACE/$CI_PROJECT_NAME"'` `'"$CI_JOB_NAME"'` Kube deploy started: to env `'"$CI_ENVIRONMENT_NAME"'` <'"$CI_JOB_URL"'|Logs>"
    }'

.script_notify_slack_deploy_finished: |
  export $(cat thread.env | xargs)
  curl --request POST \
    --header "Content-Type: application/json" \
    --header "Authorization: Bearer $SLACK_NOTIFICATIONS" \
    "https://slack.com/api/chat.postMessage" \
    --data '{
      "channel": "'$SLACK_CHANNEL'",
      "thread_ts": "'$THREAD'",
      "text": "`'"$CI_PROJECT_NAMESPACE/$CI_PROJECT_NAME"'` `'"$CI_JOB_NAME"'` Kube deploy `'"$CI_JOB_STATUS"'`: <'"$CI_JOB_URL"'|Logs>"
    }'
  if [ "$CI_JOB_STATUS" == "success" ]; then
    werf kubectl -n ${WERF_NAMESPACE} get ing -ojson | jq -r .items[].spec.rules[].host
    export URL=`werf kubectl -n ${WERF_NAMESPACE} get ing -ojson | jq -r .items[].spec.rules[].host`
    curl --request POST \
      --header "Content-Type: application/json" \
      --header "Authorization: Bearer $SLACK_NOTIFICATIONS" \
      "https://slack.com/api/chat.postMessage" \
      --data '{
        "channel": "'$SLACK_CHANNEL'",
        "thread_ts": "'$THREAD'",
        "text": "`'"$CI_PROJECT_NAMESPACE/$CI_PROJECT_NAME"'` `'"$CI_JOB_NAME"'` URL list: \n'"$URL"'"
      }'
  fi

.script_notify_slack_build_started: |
  if [[ $CI_MERGE_REQUEST_SOURCE_BRANCH_NAME == '' ]]; then
    export BRANCH=$CI_COMMIT_BRANCH
  else
    export BRANCH=$CI_MERGE_REQUEST_SOURCE_BRANCH_NAME
  fi
  if [[ $THREAD == '' ]]; then
    curl --request POST \
      --header "Content-Type: application/json" \
      --header "Authorization: Bearer $SLACK_NOTIFICATIONS" \
      "https://slack.com/api/chat.postMessage" \
      --data '{
        "channel": "'$SLACK_CHANNEL'",
        "text": "`'"$CI_PROJECT_NAMESPACE/$CI_PROJECT_NAME"'` branch `'"$BRANCH"'` by `'"$GITLAB_USER_LOGIN"'` <'"$CI_PIPELINE_URL"'|pipeline>"
      }' | jq -r '"THREAD=" + .ts' > thread.env
    export $(cat thread.env | xargs)
  else
    echo "THREAD=${THREAD}" > thread.env
  fi
  curl --request POST \
    --header "Content-Type: application/json" \
    --header "Authorization: Bearer $SLACK_NOTIFICATIONS" \
    "https://slack.com/api/chat.postMessage" \
    --data '{
      "channel": "'$SLACK_CHANNEL'",
      "thread_ts": "'$THREAD'",
      "text": "`'"$CI_PROJECT_NAMESPACE/$CI_PROJECT_NAME"'` `'"$CI_JOB_NAME"'` build started: <'"$CI_JOB_URL"'|Logs>"
    }'

.script_notify_slack_build_finished: |
  export $(cat thread.env | xargs)
  curl --request POST \
    --header "Content-Type: application/json" \
    --header "Authorization: Bearer $SLACK_NOTIFICATIONS" \
    "https://slack.com/api/chat.postMessage" \
    --data '{
      "channel": "'$SLACK_CHANNEL'",
      "thread_ts": "'$THREAD'",
      "text": "`'"$CI_PROJECT_NAMESPACE/$CI_PROJECT_NAME"'` `'"$CI_JOB_NAME"'` build `'"$CI_JOB_STATUS"'` <'"$CI_JOB_URL"'|Logs>"
    }'
