include:
  - local: '/review/main-vars.yml.example'
  - local: '/varReplicas.yml.example'
  - local: '/snippets.yml.example'

.review_werf_vars:
  variables:
    WERF_KUBE_CONTEXT: "$CONTEXT_WERF"
    WERF_SKIP_BUILD: "true"
    WERF_SET_GLOBAL_INDEX_NAME: global.index_name=$WERF_ENV
    WERF_SET_GLOBAL_REMOVE_DB_ON_DELETE: "global.remove_db_on_delete=True"
    WERF_SET_MSSQL: MSSQL=${REVIEW_MSSQL}
    WERF_SET_CLUSTER_CONTEXT: global.cluster_context=${WERF_KUBE_CONTEXT}

.werf_pre_converge_script: |
  # optional hook: run immediately before werf converge when a repo needs it

.review_werf:
  extends:
    - .base_werf
    - .review_werf_vars
  script:
    - !reference [.werf_pre_converge_script]
    - if [ -f werf_pre_converge_script.sh ]; then
        . werf_pre_converge_script.sh;
      fi

    # - werf helm dependency build .helm
    - werf converge

    - > # print ingress hosts
      echo "Project urls:";
      werf helm get manifest $(werf helm get-release) --namespace $WERF_NAMESPACE
      | yq ea -N '[ .spec.rules[].host ] | unique | .[] |= "https://" + .'
  only:
    refs:
      - pipelines
      - branches
      - tags
      - merge_requests
    variables:
      - $WERF_NEW_NAMESPACE =~ /^feature-.*/
      - $WERF_EXISTED_NAMESPACE =~ /^feature-.*/
      - $WERF_NAMESPACE =~ /^feature-.*/
      - $CI_COMMIT_REF_SLUG =~ /^feature-.*/
  needs:
    - job: "Prepare review vars"
      artifacts: true
      optional: true

.trigger:
  variables:
    UPSTREAM_PROJECT_PATH: $CI_PROJECT_PATH
    WERF_NAMESPACE: $WERF_NAMESPACE
    WERF_ENV: $WERF_ENV
    WERF_KUBE_CONTEXT: dev
    SAST_DISABLED: "true"
    SECRET_DETECTION_DISABLED: "true"
    IMAGE_SCAN_ENABLED: "false"
    WERF_SET_CLUSTER_CONTEXT: global.cluster_context=${WERF_KUBE_CONTEXT}
    WERF_SET_CDC_ENABLE: global.cdc_enable=${CDC_ENABLE}
  trigger:
    strategy: depend
  only:
    refs:
      - pipelines
      - branches
      - tags
      - merge_requests
    variables:
      - $WERF_NEW_NAMESPACE =~ /^feature-.*/
      - $WERF_EXISTED_NAMESPACE =~ /^feature-.*/
      - $WERF_NAMESPACE =~ /^feature-.*/
      - $CI_COMMIT_REF_SLUG =~ /^feature-.*/
  except:
    variables:
      - $CI_PIPELINE_SOURCE == "pipeline"
  needs:
    - job: "Prepare review vars"
      artifacts: true
    - job: Prepare review namespace

upscale_namespace:
  stage: review
#  extends:
#    - .review_werf_vars
  script: |
    kubectl run curl-upscale-$(date +%s)-$CI_JOB_ID \
      --image=example.registry/shop-app/docker-images/curl:8.14.1 \
      --restart=Never \
      --rm -it \
      --namespace=default \
      --env="WERF_NAMESPACE=$WERF_NAMESPACE" \
      -- sh -c '
        curl -X POST scale-hook.example.svc.cluster.local:8000/scale-up?namespace=$WERF_NAMESPACE;
      '
  only:
    refs:
      - pipelines
      - branches
      - tags
      - merge_requests
    variables:
      - $WERF_NEW_NAMESPACE =~ /^feature-.*/
      - $WERF_EXISTED_NAMESPACE =~ /^feature-.*/
      - $WERF_NAMESPACE =~ /^feature-.*/
      - $CI_COMMIT_REF_SLUG =~ /^feature-.*/
  tags:
    - docker

.needs_infra:
  needs:
    - job: "Prepare review vars"
      artifacts: true
      optional: true
    - job: Prepare review namespace
    - job: Deploy review haproxy
      optional: true
    - job: Deploy review envoy-gateway
      optional: true
    - job: Deploy ingresses
      optional: true
    - job: Deploy envoy-gateway-routes
      optional: true
    - job: Deploy rabbitmq
      optional: true
    - job: Deploy redis
      optional: true
    - job: Deploy clickhouse
      optional: true
    - job: upscale_namespace
      optional: true

# also see shop-app/review → Prepare review vars
Prepare review vars:
  stage: build
  before_script:
    - !reference [.snippets, dump_env]
  script:
    - | # feature branches only
      [[ $CI_COMMIT_REF_SLUG  =~ ^feature.* ]] && WERF_ENV=$CI_COMMIT_REF_SLUG

    - | #
      if [[ $CI_COMMIT_REF_SLUG =~ (^feature-[a-zA-Z-]+-[0-9]+).* ]] && [[ ${#BASH_REMATCH[1]} < 40 ]]; then
        WERF_ENV=${BASH_REMATCH[1]}
        WERF_NAMESPACE=${BASH_REMATCH[1]}
      fi

    - | # write namespace and environment as a dotenv artifact
      tee variables.env << EOF
      WERF_NAMESPACE=$WERF_NAMESPACE
      WERF_ENV=$WERF_ENV
      WERF_KUBE_CONTEXT=$WERF_KUBE_CONTEXT
      EOF
  artifacts:
    reports:
      dotenv: variables.env
  except:
    variables:
      - $CI_PIPELINE_SOURCE == "pipeline"
  only:
    refs:
      - pipelines
      - branches
      - tags
      - merge_requests
    variables:
      - $CI_COMMIT_REF_SLUG =~ /^feature-.*/
  tags:
    - docker

.base_review_deploy:
  extends:
    - .base_werf
  variables:
    WERF_KUBE_CONTEXT: dev
    WERF_SET_CLUSTER_CONTEXT: global.cluster_context=${WERF_KUBE_CONTEXT}
  needs:
    - job: "Prepare review vars"
      artifacts: true
      optional: true
  when: manual
  only:
    refs:
      - pipelines
      - branches
      - tags
      - merge_requests
    variables:
      - $WERF_NEW_NAMESPACE =~ /^feature-.*/
      - $WERF_EXISTED_NAMESPACE =~ /^feature-.*/
      - $WERF_NAMESPACE =~ /^feature-.*/
      - $CI_COMMIT_REF_SLUG =~ /^feature-.*/
  except:
    variables:
      - $CI_PIPELINE_SOURCE == "pipeline"
  tags:
    - docker

# Base job definition that will be used for both automatic and manual versions
.start_deploy_to_review_namespace_base:
  stage: start_review
  script:
    - |
      JOB_ID=$(curl -s -XGET -H "PRIVATE-TOKEN: ${CI_DEPLOY_TRIGGER_TOKEN}" "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/pipelines/${CI_PIPELINE_ID}/jobs" | jq --arg name "Prepare review namespace" '.[] | select(.name == $name) | .id')
    - |
      curl -s --request POST --header "PRIVATE-TOKEN: ${CI_DEPLOY_TRIGGER_TOKEN}" "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/jobs/${JOB_ID}/play"

# automatic play for the review hub project
Start deploy to review namespace (auto):
  extends:
    - .base_review_deploy
    - .start_deploy_to_review_namespace_base
  when: on_success
  only:
    refs:
      - pipelines
      - branches
      - tags
      - merge_requests
    variables:
      - $CI_PROJECT_PATH_SLUG == "shop-app-review"
  except:
    variables:
      - $CI_PIPELINE_SOURCE == "pipeline"

# Manual version for all other projects
Start deploy to review namespace:
  extends:
    - .base_review_deploy
    - .start_deploy_to_review_namespace_base
  only:
    refs:
      - pipelines
      - branches
      - tags
      - merge_requests
    variables:
      - $WERF_NEW_NAMESPACE =~ /^feature-.*/
      - $WERF_EXISTED_NAMESPACE =~ /^feature-.*/
      - $WERF_NAMESPACE =~ /^feature-.*/
      - $CI_COMMIT_REF_SLUG =~ /^feature-.*/
  except:
    variables:
      - $CI_PROJECT_PATH_SLUG == "shop-app-review"
      - $CI_PIPELINE_SOURCE == "pipeline"

Retry failed jobs in review stage:
  extends:
    - .base_review_deploy
  stage: retry_review
  script:
    - |
      FAILED_JOBS=$(curl -s -XGET -H "PRIVATE-TOKEN: ${CI_DEPLOY_TRIGGER_TOKEN}" "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/pipelines/${CI_PIPELINE_ID}/bridges" | jq -r '.[] | select(.status == "failed") | .id')
      if [ -z "$FAILED_JOBS" ]; then
          echo "No failed jobs found."
          exit 0
      fi
      echo ${FAILED_JOBS}
      for JOB_ID in ${FAILED_JOBS}; do
          echo "Replaying failed job with ID: $JOB_ID"
          curl -s -XPOST --header "PRIVATE-TOKEN: ${CI_DEPLOY_TRIGGER_TOKEN}" "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/jobs/${JOB_ID}/retry"
      done
      echo "All failed jobs have been retried."

Prepare review namespace:
  stage: review
  extends:
    - .base_review_deploy
  manual_confirmation: "⛔️ do not run this job"
  script:
    - !reference [.snippets, create_ns]

Deploy review haproxy:
  extends:
    - .trigger
  stage: review
  trigger:
    project: shop-app/review-haproxy


Deploy review envoy-gateway:
  extends:
    - .trigger
  stage: review
  trigger:
    project: shop-app/envoy-gateway


Deploy ingresses:
  extends:
    - .trigger
  stage: review
  trigger:
    project: shop-app/ingresses
  only:
    variables:
      - $REVIEW_INGRESSES
      - $REVIEW_WEB_UI_SHOP_BRANCH
      - $REVIEW_WEB_UI_EXTERNAL_CI_BRANCH

Deploy envoy-gateway-routes:
  extends:
