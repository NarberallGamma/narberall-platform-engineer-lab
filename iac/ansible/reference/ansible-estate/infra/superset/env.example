# Copy to .env next to docker-compose.yml and fill in values.
# Do not commit secrets.

COMPOSE_PROJECT_NAME=estate-superset

# Docker Hub image (tag = Superset release). Current stable: https://github.com/apache/superset/releases
SUPERSET_IMAGE=apache/superset:6.0.0

# --- Superset (pythonpath/superset_config.py, via env_file in compose) ---

# Required: openssl rand -base64 42
SUPERSET_SECRET_KEY=

# Password of the PostgreSQL user in the db container (user superset, database superset).
# Do not use @ : / ? # in the value (otherwise interpolation into SQLALCHEMY_DATABASE_URI in compose breaks).
POSTGRES_PASSWORD=

# SQLALCHEMY_DATABASE_URI and REDIS_URL are set in docker-compose.yml (hosts db and redis).
# Override: add the variables in .env and in the environment block of the superset* services in compose.

# --- First start: docker compose --profile init run --rm superset-init ---

# Password of the first administrator. In image 6.0.0 docker-init.sh creates user
# admin / admin@superset.com with this password (name and email are hardcoded in the upstream script).
ADMIN_PASSWORD=

# --- Mode (docker-init and the application read from .env) ---

SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
FLASK_DEBUG=false

# --- Authentication: db (local users only) or oauth (ADFS OIDC) ---
# db — no ADFS, suitable for debugging. oauth — prod: set OAUTH_CLIENT_* below.
SUPERSET_AUTH_TYPE=db

# Register on first OAuth login; default role when the ADFS group does not match
AUTH_USER_REGISTRATION_ROLE=Public
AUTH_ROLES_SYNC_AT_LOGIN=true

# Confidential ADFS application credentials (OIDC) — issue in ADFS, do not commit
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ADFS OIDC metadata (replace the host when needed)
OAUTH_SERVER_METADATA_URL=https://adfs.example.com/adfs/.well-known/openid-configuration

# Debug only for HTTP to the IdP (usually 0 in prod)
OAUTHLIB_INSECURE_TRANSPORT=0

# Resolve the ADFS name to an internal IP (split-DNS). Format host:ip. An empty value is not supported in compose —
# drop extra_hosts via an override file when needed.
ADFS_EXTRA_HOST_ENTRY=adfs.example.com:10.10.12.4
