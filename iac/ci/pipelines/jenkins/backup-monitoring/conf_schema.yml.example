---

type: map
required: false
mapping:
  regex;(^(.{1,255})$):
    type: map
    mapping:
      state:
        type: str
        enum: ['enable', 'disable']
        required: false
      age:
        type: int
        required: false
        range:
          min: 1
      disable_limit:
        type: int
        required: false
        range:
          min: 1
      size:
        type: str
        required: false
        pattern: '^((([0-9]|[1-9][0-9]*)[KMGTPE]{0,1}B{0,1})|(([0-9]\.[0-9][0-9]*|[1-9][0-9]*\.[0-9][0-9]*)[KMGTPE]{1,1}B{0,1}))$'
      size_decrease:
        type: int
        required: false
        range:
          min: 1
          max: 100
