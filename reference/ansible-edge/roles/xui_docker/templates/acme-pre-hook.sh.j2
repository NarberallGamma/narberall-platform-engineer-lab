#!/bin/sh
# acme.sh --pre-hook: освободить порт HTTP перед standalone renew/issue
set -eu
STATE="{{ xui_app_base_dir }}/.acme-stopped-services"
: > "${STATE}"
{% for svc in xui_acme_stop_services_before_issue %}
if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet {{ svc }} 2>/dev/null; then
  systemctl stop {{ svc }} || true
  echo {{ svc }} >> "${STATE}"
fi
{% endfor %}
