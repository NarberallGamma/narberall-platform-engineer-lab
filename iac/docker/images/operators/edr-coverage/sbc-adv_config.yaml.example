# enterprise_project_id (optional, per company) — which SberCloud scope is used
# to check ECS read rights:
#   omitted          — IAM project (regional). Grant the account rights on the
#                      IAM project (Authorization model: IAM project).
#   "all_granted_eps" — all enterprise projects where the account has roles.
#                      Set this when IAM rights are granted via enterprise
#                      projects (common with a single project).
#   "0" or "<id>"    — a specific enterprise project ("0" is the default EP).
# If ECS returns 403 Pdp.0001 while enterprise roles are already granted —
# add "enterprise_project_id": "all_granted_eps".
companies: [
  {
    "name": "project-e",
    "ak": "CHANGE_ME",
    "sk": "CHANGE_ME",
    "sts": "",
    "enterprise_project_id": "all_granted_eps",
    "extra": {
      "root_project_id": "00000000-0000-4000-8000-000000000002",
      # https: //console.hc.sbercloud.ru/iam/?agencyId=CHANGE_ME&region=ru-moscow-1&locale=en-us#/mine/apiCredential
      endpoint_iam: "iam.ru-moscow-1.hc.sbercloud.ru",
      "endpoint_ecs": "ecs.ru-moscow-1.hc.sbercloud.ru"
    }
  },
  {
    "name": "project-c",
    "ak": "CHANGE_ME",
    "sk": "CHANGE_ME",
    "sts": "",
    "extra": {
      "root_project_id": "00000000-0000-4000-8000-000000000003",
      # https://console.hc.sbercloud.ru/iam/?agencyId=CHANGE_ME&region=ru-moscow-1&locale=en-us#/mine/apiCredential
      "endpoint_iam": "iam.ru-moscow-1.hc.sbercloud.ru",
      "endpoint_ecs": "ecs.ru-moscow-1.hc.sbercloud.ru"
    }
  },
  {
    "name": "project-b",
    "ak": "CHANGE_ME",
    "sk": "CHANGE_ME",
    "sts": "",
    "extra": {
      "root_project_id": "00000000-0000-4000-8000-000000000004",
      # https://console.hc.sbercloud.ru/iam/?agencyId=CHANGE_ME&region=ru-moscow-1&locale=en-us#/mine/apiCredential
      "endpoint_iam": "iam.ru-moscow-1.hc.sbercloud.ru",
      "endpoint_ecs": "ecs.ru-moscow-1.hc.sbercloud.ru"
    }
  }
]