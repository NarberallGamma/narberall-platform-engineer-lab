services:
  hsm-bootstrap:
    image: {{ docker_app.bootstrap_image }}
    container_name: treasury-hsm-bootstrap
    volumes:
      - ./data/keys:/var/opt/cprocsp/keys/cprouser
      - ./data/users:/var/opt/cprocsp/users/cprouser
      - ./data/dsrf:/var/opt/cprocsp/dsrf
    command:
      - sh
      - -c
      - >-
        cd /archives &&
        tar -xzf keys.tar.gz -C /var/opt/cprocsp/keys/cprouser &&
        tar -xzf users.tar.gz -C /var/opt/cprocsp/users/cprouser &&
        tar -xzf dsrf.tar.gz -C /var/opt/cprocsp/dsrf &&
        chown -R 10001:10001 /var/opt/cprocsp/keys/cprouser /var/opt/cprocsp/users/cprouser /var/opt/cprocsp/dsrf || true
    restart: "no"

  hsm-adapter:
    image: {{ docker_app.adapter_image }}
    container_name: treasury-hsm-adapter
    user: "10001:10001"
    depends_on:
      - hsm-bootstrap
    ports:
      - "8080:8080"
{% if docker_app.management_port_enabled | default(false) | bool %}
      - "8081:8081"
{% endif %}
    env_file:
      - .env
    environment:
      - SPRING_PROFILES_ACTIVE=production
      - SERVER_PORT=8080
{% if docker_app.management_port_enabled | default(false) | bool %}
      - MANAGEMENT_SERVER_PORT=8081
{% endif %}
      - SERVER_FORWARD_HEADERS_STRATEGY=framework
      - MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE={{ docker_app.management_endpoints | default('health,info,metrics,prometheus') }}
      - MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
      - LOGGING_LEVEL_ROOT={{ docker_app.logging_level_root | default('INFO') }}
      - LOGGING_LEVEL_COM_WAVESPLATFORM={{ docker_app.logging_level_waves | default('DEBUG') }}
    volumes:
      - ./data/keys:/var/opt/cprocsp/keys/cprouser
      - ./data/users:/var/opt/cprocsp/users/cprouser
      - ./data/dsrf:/var/opt/cprocsp/dsrf
      - ./data/tmp:/var/opt/cprocsp/tmp
    tmpfs:
      - /tmp:rw,exec,size=100m
    restart: unless-stopped
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          curl -sf http://localhost:{{ docker_app.healthcheck_port | default(8080) }}/actuator/health >/dev/null || exit 1
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
