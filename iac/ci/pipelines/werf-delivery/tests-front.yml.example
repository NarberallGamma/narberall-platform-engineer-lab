include:
  - local: "common.yml.example"

variables:
  # Enable feature flag
  FF_USE_FASTZIP: "true"
  # These can be specified per job or per pipeline
  ARTIFACT_COMPRESSION_LEVEL: "fast"
  CACHE_COMPRESSION_LEVEL: "fast"

.base_test: &base_test
  stage: test
  image: $WERF_BUILD_DOCKER_IMAGE_NAME
  needs:
    - job: Build
      artifacts: true
  tags: [docker]

test_stories:
  extends:
    - .base_test
  script:
    - |
      cd /app
      npm run storybook &
      sleep 30
      npm run test:stories
  rules:
    - !reference [.rule_not_schedule]
    - if: $RUN_TEST_STORIES
      when: on_success

