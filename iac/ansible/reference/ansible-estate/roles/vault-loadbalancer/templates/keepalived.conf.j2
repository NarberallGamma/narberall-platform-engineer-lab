global_defs {
    router_id {{ keepalived_router_id }}
    enable_script_security
    script_user root
}

vrrp_script chk_nginx {
    script "/usr/bin/curl -f -k https://localhost:{{ lb_port }}/nginx-health || exit 1"
    interval {{ keepalived_health_check_interval }}
    weight -2
    fall {{ keepalived_health_check_fall }}
    rise {{ keepalived_health_check_rise }}
}

vrrp_instance VAULT_LB {
    state {% if inventory_hostname in groups['vault_lb'][0] %}MASTER{% else %}BACKUP{% endif %}
    priority {% if inventory_hostname in groups['vault_lb'][0] %}{{ lb_nodes[0].priority }}{% else %}{{ lb_nodes[1].priority }}{% endif %}

    interface {{ vault_virtual_interface }}
    virtual_router_id 51
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    virtual_ipaddress {
        {{ vault_virtual_ip }}/24
    }

    track_script {
        chk_nginx
    }

    notify_master "/bin/echo 'MASTER: {{ inventory_hostname }}' >> /var/log/keepalived.log"
    notify_backup "/bin/echo 'BACKUP: {{ inventory_hostname }}' >> /var/log/keepalived.log"
    notify_fault "/bin/echo 'FAULT: {{ inventory_hostname }}' >> /var/log/keepalived.log"
}
