# Managed by ansible (sec_stack): generated from SOPS secrets on top of
# stack/alertmanager/alertmanager.yml. Edits go in the role template.
templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  receiver: default
  group_by: [alertname, site]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  routes:
    # Heartbeat is sent separately and often, bypassing grouping
    - matchers: [alertname = DeadManSwitch]
      receiver: heartbeat
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
    - matchers: [severity = critical]
      receiver: critical

receivers:
  - name: default
{% if sec_stack_telegram_bot_token and sec_stack_telegram_chat_id_default %}
    telegram_configs:
      - bot_token: "{{ sec_stack_telegram_bot_token }}"
        chat_id: {{ sec_stack_telegram_chat_id_default }}
        parse_mode: HTML
        message: '{{ '{{ template "sec_stack.telegram" . }}' }}'
{% endif %}

  - name: critical
{% if sec_stack_telegram_bot_token and sec_stack_telegram_chat_id_critical %}
    telegram_configs:
      - bot_token: "{{ sec_stack_telegram_bot_token }}"
        chat_id: {{ sec_stack_telegram_chat_id_critical }}   # "watchman yelling" chat
        parse_mode: HTML
        message: '{{ '{{ template "sec_stack.telegram" . }}' }}'
{% endif %}

  - name: heartbeat
{% if sec_stack_heartbeat_url %}
    webhook_configs:
      - url: "{{ sec_stack_heartbeat_url }}"
        send_resolved: false
{% endif %}

inhibit_rules:
  # When the firewall is fully unreachable — do not spam about its tunnels/licenses
  - source_matchers: [alertname = PanosUnreachable]
    target_matchers: [alertname =~ "Panos(IpsecTunnelDown|HAUnhealthyState|SessionUsageHigh)"]
    equal: [firewall]
  # NB: a PanosHAUnhealthyState -> PanosIpsecTunnelDown rule is INTENTIONALLY absent here.
  # HAUnhealthyState also fires when the peer is unhealthy, and its firewall label is
  # the local node: with peer=suspended it suppressed tunnel alerts of the HEALTHY
  # active node. Non-active nodes are filtered in the PanosIpsecTunnelDown rule itself (vmalert).
