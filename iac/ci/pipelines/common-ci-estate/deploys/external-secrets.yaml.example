include:
  - local: '/defaults.yaml.example'

stages:
  - deploy-external-secrets
  - verify-external-secrets
  - rollback-external-secrets

variables:
  HELM_RELEASE_NAME: "external-secrets"
  HELM_NAMESPACE: "external-secret-manager"

default:
  tags:
    - docker
  timeout: 8h
  interruptible: true

.k8s_setup: &k8s_setup
  image: $BASE_IMAGE
  before_script:
    - init.sh

deploy-external-secrets:
  <<: *k8s_setup
  stage: deploy-external-secrets
  script:
    - echo "Deploying External Secrets Operator..."
    - kubectl create namespace $HELM_NAMESPACE --dry-run=client -o yaml | kubectl apply -f -
    - echo "Installing External Secrets Operator with production values..."
    - helm upgrade --install $HELM_RELEASE_NAME external-secrets/external-secrets 
      --namespace $HELM_NAMESPACE 
      --create-namespace
      --values values.yaml
      --wait
      --timeout=10m
    - echo "Waiting for External Secrets pods to be ready..."
    - kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=external-secrets -n $HELM_NAMESPACE --timeout=600s
    - echo "External Secrets deployed successfully"
    - kubectl get pods -n $HELM_NAMESPACE
    - echo "Checking pod distribution across nodes..."
    - kubectl get pods -n $HELM_NAMESPACE -o wide
    - echo "Pod distribution check:"
    - kubectl get pods -n $HELM_NAMESPACE -o custom-columns=NAME:.metadata.name,NODE:.spec.nodeName
    - kubectl get crd | grep external-secrets
  when: manual
  only:
    - main
    - develop

verify-external-secrets:
  <<: *k8s_setup
  stage: verify-external-secrets
  script:
    - echo "Verifying External Secrets deployment..."
    - kubectl get pods -n $HELM_NAMESPACE
    - kubectl get deploy -n $HELM_NAMESPACE -o custom-columns=NAME:.metadata.name,REPLICAS:.spec.replicas,AVAILABLE:.status.availableReplicas
    - echo "Checking pod distribution across nodes..."
    - kubectl get pods -n $HELM_NAMESPACE -o custom-columns=NAME:.metadata.name,NODE:.spec.nodeName
    - echo "Checking CRDs..."
    - kubectl get crd | grep external-secrets
    - echo "Testing External Secrets CRD..."
    - kubectl get clusterSecretStore vault-cluster-secret-store || echo "No ClusterSecretStore found"
    - kubectl get secretstore -A || echo "No SecretStores found"
    - kubectl get externalsecret -A || echo "No ExternalSecrets found"
    - echo "External Secrets verification completed successfully"
  when: manual
  only:
    - main
    - develop

rollback-external-secrets:
  <<: *k8s_setup
  stage: rollback-external-secrets
  script:
    - echo "Rolling back External Secrets deployment..."
    - helm rollback $HELM_RELEASE_NAME -n $HELM_NAMESPACE
    - echo "External Secrets rollback completed"
  when: manual
  only:
    - main
    - develop
