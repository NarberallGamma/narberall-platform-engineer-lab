      - $REVIEW_ECOM_KIOSK_BRANCH

Smoke tests:
  stage: test
  variables:
    ENV_NAME: "$WERF_NAMESPACE"
    SETUP_STAND: "True"
    ALLURE_LAUNCH_NAME: "Triggered by deploy to $WERF_NAMESPACE"
    TESTS_MARKER: "refactor_api_basic_smoke"
  trigger:
    project: 'shop-app/qa/smoke-tests'
    branch: 'develop'
    strategy: depend
  needs:
  - job: Prepare review vars
    artifacts: true
    optional: true
  when: manual

Deploy users for clickhouse:
  extends:
    - .trigger
  stage: review
  trigger:
    project: shop-app/clickhouse-users
  only:
    variables:
      # Deploy clickhouse ("!reference" produces an error)
      - $REVIEW_CLICKHOUSE
      - $REVIEW_CUBE_BRANCH
      - $REVIEW_ETL_BRANCH
      - $REVIEW_RECOMMENDATION_BRANCH
      - $REVIEW_MARKETING_BRANCH
      - $REVIEW_MARKETING_SEGMENTS_BRANCH
      - $REVIEW_CUSTOMERS_IMPORT_BRANCH
      - $REVIEW_WEBANALYTICS_BRANCH
      - $REVIEW_NOTIFICATIONS_BRANCH
      - $REVIEW_BI_CLICKHOUSE_BRANCH
      # Deploy review data-platform-clickhouse ("!reference" produces an error)
